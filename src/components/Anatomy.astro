---
/**
 * « Pensé dans le détail » — fiche de conception sur photo réelle (vue de dessus).
 * Les repères sont positionnés en % dans un cadre au ratio exact de la photo :
 * ils restent alignés à toutes les largeurs. Les points invisibles de dessus
 * (soutien avant, fermeture) sont montrés sur des photos de détail, sans position inventée.
 */
import { Image } from "astro:assets";
import { PILLOW } from "../config/product";
import top from "../assets/images/oreiller-dessus.webp";
import profil from "../assets/images/detail-profil.webp";
import zip from "../assets/images/detail-fermeture.webp";
const details: Record<string, { src: typeof profil; alt: string; cap: string }> = {
  profil: { src: profil, alt: "L’oreiller vu de profil : contour avant et passepoil", cap: "Vue de profil" },
  fermeture: { src: zip, alt: "Fermeture à glissière de la housse, ouverte sur les inserts", cap: "Détail de la housse" },
};
const pts = PILLOW.anatomy;
---
<div class="ana" data-ana>
  <figure class="ana__photo">
    <div class="ana__frame" style={`aspect-ratio: ${top.width} / ${top.height}`}>
      <Image src={top} alt="L’oreiller REVIVE GROW vu de dessus : forme anatomique, côtés larges et zone centrale abaissée" widths={[600, 900, 1300, 1672]} sizes="(min-width: 960px) 58vw, 100vw" quality={84} class="ana__img" />
      {pts.filter((p) => p.x !== null).map((p) => (
        <button type="button" class="ana__pin" style={`left:${p.x}%; top:${p.y}%`} data-pt={p.n} aria-label={`${p.n}. ${p.title}`} aria-controls={`ana-pt-${p.n}`}>
          <span class="t-num">{p.n}</span>
        </button>
      ))}
    </div>
    <figcaption class="ana__cap">Vue de dessus · photographie du produit</figcaption>
  </figure>

  <ol class="ana__list" role="list">
    {pts.map((p) => (
      <li class="ana__item" id={`ana-pt-${p.n}`} data-pt={p.n} tabindex="-1">
        <span class="ana__n t-num" aria-hidden="true">{p.n}</span>
        <div class="ana__txt">
          <h3 class="t-h4">{p.title}</h3>
          <p class="t-muted t-small">{p.text}</p>
        </div>
        {p.detail && (
          <figure class="ana__detail">
            <Image src={details[p.detail].src} alt={details[p.detail].alt} widths={[240, 480]} sizes="120px" class="ana__dimg" />
            <figcaption>{details[p.detail].cap}</figcaption>
          </figure>
        )}
      </li>
    ))}
  </ol>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-ana]").forEach((root) => {
    const set = (n: string | null) => {
      root.querySelectorAll<HTMLElement>("[data-pt]").forEach((el) => el.classList.toggle("is-on", el.dataset.pt === n));
    };
    root.querySelectorAll<HTMLElement>(".ana__pin").forEach((pin) => {
      pin.addEventListener("click", () => {
        const n = pin.dataset.pt ?? null; set(n);
        const item = root.querySelector<HTMLElement>(`.ana__item[data-pt="${n}"]`);
        if (item && window.matchMedia("(max-width: 959px)").matches) item.scrollIntoView({ block: "nearest", behavior: "smooth" });
      });
      pin.addEventListener("mouseenter", () => set(pin.dataset.pt ?? null));
      pin.addEventListener("focus", () => set(pin.dataset.pt ?? null));
    });
    root.querySelectorAll<HTMLElement>(".ana__item").forEach((it) => {
      it.addEventListener("mouseenter", () => set(it.dataset.pt ?? null));
    });
    root.addEventListener("mouseleave", () => set(null));
  });
</script>

<style>
  .ana { display: grid; gap: var(--s-6); align-items: start; }
  @media (min-width: 960px) { .ana { grid-template-columns: 1.45fr 1fr; gap: var(--s-8); align-items: center; } }

  .ana__photo { margin: 0; display: grid; gap: var(--s-3); }
  .ana__frame { position: relative; width: 100%; max-width: 100%; background: var(--c-photo); border-radius: var(--r-lg); overflow: hidden; }
  .ana__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .ana__cap { font-size: var(--fs-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-encre-douce); }

  .ana__pin {
    position: absolute; transform: translate(-50%, -50%);
    display: grid; place-items: center; width: clamp(30px, 2.6vw + 18px, 42px); aspect-ratio: 1;
    border-radius: 50%; background: var(--c-encre); color: var(--c-ivoire);
    font-size: clamp(0.95rem, 0.5vw + 0.8rem, 1.2rem);
    box-shadow: 0 0 0 4px rgb(255 253 249 / 0.85), 0 6px 18px -6px rgb(34 32 28 / 0.45);
    transition: transform var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }
  .ana__pin::after { content: ""; position: absolute; inset: -10px; } /* zone tactile ≥ 44 px */
  .ana__pin.is-on, .ana__pin:hover { background: var(--c-sauge); transform: translate(-50%, -50%) scale(1.12); }
  @media (prefers-reduced-motion: no-preference) {
    .ana__pin { animation: pin-in var(--dur-slow) var(--ease) backwards; }
    .ana__pin:nth-of-type(2) { animation-delay: 80ms; } .ana__pin:nth-of-type(3) { animation-delay: 160ms; }
    @keyframes pin-in { from { opacity: 0; transform: translate(-50%, -50%) scale(0.6); } }
  }

  .ana__list { display: grid; }
  .ana__item { display: grid; grid-template-columns: 2.25rem 1fr auto; gap: var(--s-3); align-items: center; padding-block: var(--s-4); border-top: var(--hairline); transition: background-color var(--dur) var(--ease); border-radius: 2px; outline: none; }
  .ana__item:last-child { border-bottom: var(--hairline); }
  .ana__n { display: grid; place-items: center; width: 2rem; aspect-ratio: 1; border-radius: 50%; border: 1px solid var(--c-sable); font-size: 1.05rem; color: var(--c-encre); transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease); }
  .ana__item.is-on .ana__n { background: var(--c-sauge); border-color: var(--c-sauge); color: var(--c-ivoire); }
  .ana__txt { display: grid; gap: 2px; min-width: 0; }
  .ana__detail { margin: 0; display: grid; gap: 4px; justify-items: end; }
  .ana__dimg { width: clamp(88px, 22vw, 120px); aspect-ratio: 4 / 3; height: auto; object-fit: cover; border-radius: var(--r-sm); }
  .ana__detail figcaption { font-size: 0.6875rem; color: var(--c-encre-douce); }
</style>
