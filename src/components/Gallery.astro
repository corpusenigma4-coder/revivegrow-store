---
/** Galerie produit : défilement tactile (scroll-snap) sur mobile, mosaïque sur ordinateur. */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props { images: { src: ImageMetadata; alt: string }[] }
const { images } = Astro.props;
---
<div class="gal" data-gal>
  <ul class="gal__track" role="list" aria-label="Photos du pack" data-gal-track tabindex="0">
    {images.map((im, i) => (
      <li class="gal__slide">
        <Image src={im.src} alt={im.alt} widths={[480, 800, 1200]} sizes="(min-width: 960px) 30vw, 100vw" quality={80} loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : undefined} class="gal__img" />
      </li>
    ))}
  </ul>
  <p class="gal__count t-tabular" aria-hidden="true"><span data-gal-i>1</span> / {images.length}</p>
</div>
<script>
  document.querySelectorAll<HTMLElement>("[data-gal]").forEach((g) => {
    const track = g.querySelector<HTMLElement>("[data-gal-track]");
    const out = g.querySelector<HTMLElement>("[data-gal-i]");
    if (!track || !out) return;
    track.addEventListener("scroll", () => {
      const i = Math.round(track.scrollLeft / track.clientWidth) + 1;
      out.textContent = String(i);
    }, { passive: true });
  });
</script>
<style>
  .gal { position: relative; }
  .gal__track { display: grid; grid-auto-flow: column; grid-auto-columns: 100%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin-inline: calc(-1 * var(--gutter)); overscroll-behavior-x: contain; }
  .gal__track::-webkit-scrollbar { display: none; }
  .gal__slide { scroll-snap-align: start; }
  .gal__img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; background: var(--c-lin); }
  .gal__img { aspect-ratio: 3 / 2; }
  .gal__slide:first-child .gal__img { object-fit: contain; background: var(--c-studio); }
  .gal__count { position: absolute; right: 0; bottom: var(--s-3); padding: 2px 10px; border-radius: var(--r-pill); background: rgb(255 253 249 / 0.9); font-size: var(--fs-xs); font-weight: 600; }
  @media (min-width: 960px) {
    .gal__track { grid-auto-flow: row; grid-template-columns: 1fr 1fr; gap: var(--s-3); overflow: visible; margin: 0; }
    .gal__slide:first-child { grid-column: 1 / -1; }
    .gal__slide:first-child .gal__img { aspect-ratio: 1672 / 736; }
    .gal__img { border-radius: var(--r-md); }
    .gal__count { display: none; }
  }
</style>
