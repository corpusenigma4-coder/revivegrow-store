---
import { CONTACT } from "../config/commerce";
const links = [["/cgv/", "CGV"], ["/livraison/", "Livraison"], ["/retours/", "Retours"], ["/confidentialite/", "Confidentialité"], ["/mentions-legales/", "Mentions légales"]];
---
<footer class="cftr">
  <div class="container cftr__inner">
    <p>Une question&nbsp;? <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></p>
    <nav aria-label="Informations"><ul role="list">{links.map(([h, l]) => <li><a href={h}>{l}</a></li>)}</ul></nav>
  </div>
</footer>
<style>
  .cftr { padding-block: var(--s-6) calc(var(--s-6) + env(safe-area-inset-bottom)); border-top: var(--hairline); font-size: var(--fs-xs); color: var(--c-encre-douce); }
  .cftr__inner { display: grid; gap: var(--s-3); justify-items: center; text-align: center; }
  .cftr a { color: inherit; overflow-wrap: anywhere; }
  .cftr ul { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-2) var(--s-4); }
  .cftr li a { display: inline-block; padding-block: 6px; }
</style>
