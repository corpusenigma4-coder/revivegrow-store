---
/**
 * Bloc d'achat du pack — ce que l'on achète, le prix final, la livraison, puis le paiement officiel PayPal.
 * « Obtenir l’offre » mène directement au tunnel /commande/ (récapitulatif → livraison → paiement PayPal).
 */
import { CAMPAIGN } from "../config/campaign";
import { PACK, SERVICE } from "../config/product";
import { CONTACT } from "../config/commerce";
import Price from "./Price.astro";
import PackList from "./PackList.astro";
import Button from "./Button.astro";
import PayMethods from "./PayMethods.astro";
import Icon from "./Icon.astro";
interface Props { headingLevel?: "h1" | "h2"; id?: string }
const { headingLevel: H = "h2", id = "commander" } = Astro.props;
const showSaving = Boolean(CAMPAIGN.referencePrice.evidence);
---
<div class="buy" id={id}>
  <div class="buy__live">
    <header class="buy__head">
      {CAMPAIGN.enabled && <p class="buy__eyebrow t-eyebrow">{showSaving ? CAMPAIGN.name : "Offre exclusive · Pré-Black Friday"}</p>}
      <H class="t-h3 buy__title">{PACK.name}</H>
      <div class="buy__price">
        <Price size="xl" />
      </div>
      <ul class="buy__chips" role="list">
        <li class="chip chip--gift"><Icon name="gift" size={16} /> 2 cadeaux offerts</li>
        <li class="chip"><Icon name="truck" size={16} /> {SERVICE.delivery.label}</li>
      </ul>
    </header>

    <div class="buy__incl">
      <p class="buy__label">Inclus dans votre pack</p>
      <PackList />
    </div>

    <p class="buy__ship"><Icon name="truck" size={20} /><span><strong>{SERVICE.delivery.label}</strong> · {SERVICE.delivery.delay.replace("sous ", "")}<br /><span class="t-muted">{SERVICE.delivery.zone}, les trois articles dans le même colis</span></span></p>

    <div id="paiement" class="buy__pay"><Button href="/commande/" size="lg" block data-cta="offre">Obtenir l’offre</Button><PayMethods align="center" /></div>

    <ul class="buy__reassure" role="list">
      <li><Icon name="return" size={20} /><span><a href="/garantie-90-jours">90 jours pour changer d’avis</a>, en plus de vos droits légaux</span></li>
      <li><Icon name="mail" size={20} /><span>Une question avant de commander&nbsp;? <a href={`mailto:${CONTACT.email}`}>Écrivez-nous</a></span></li>
    </ul>
  </div>

  <div class="buy__ended" role="status">
    <p class="t-eyebrow">Offre terminée</p>
    <p class="t-h3">L’offre spéciale Pré-Black Friday est terminée.</p>
    <p class="t-muted">Pour toute question&nbsp;: <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>.</p>
  </div>
</div>

<style>
  .buy { display: grid; gap: var(--s-5); }
  .buy__live { display: grid; gap: var(--s-5); }
  .buy__head { display: grid; gap: var(--s-3); }
  .buy__eyebrow { color: var(--c-terre); }
  .buy__chips { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .chip { display: inline-flex; align-items: center; gap: 6px; min-height: 32px; padding: 4px 12px; border-radius: var(--r-pill); background: var(--c-lin); font-size: 0.8125rem; font-weight: 600; color: var(--c-encre); }
  .chip--gift { background: var(--c-sauge-pale); color: var(--c-sauge); }
  .buy__label { font-size: var(--fs-xs); font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-encre-douce); }
  .buy__incl { display: grid; gap: var(--s-1); }
  .buy__ship { display: grid; grid-template-columns: auto 1fr; gap: var(--s-3); align-items: start; padding: var(--s-4); border-radius: var(--r-md); background: var(--c-lin); font-size: var(--fs-sm); line-height: 1.5; }
  .buy__ship :global(.icon) { color: var(--c-sauge); margin-top: 1px; }
  .buy__ship strong { font-weight: 600; }
  .buy__pay { display: grid; gap: var(--s-3); scroll-margin-top: calc(var(--header-h) + var(--s-6)); }
  .buy__pay :global(.btn) { min-height: 58px; font-size: 1.0625rem; }
  .buy__reassure { display: grid; gap: var(--s-3); font-size: var(--fs-sm); line-height: 1.45; }
  .buy__reassure li { display: grid; grid-template-columns: auto 1fr; gap: var(--s-3); align-items: start; }
  .buy__reassure :global(.icon) { color: var(--c-sauge); }
  .buy__reassure a { color: var(--c-encre); }
  .buy__ended { display: none; gap: var(--s-3); padding: var(--s-5); border: var(--hairline); border-radius: var(--r-md); }
  :global(html[data-offer="closed"]) .buy__live { display: none; }
  :global(html[data-offer="closed"]) .buy__ended { display: grid; }
</style>
