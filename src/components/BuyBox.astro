---
/**
 * Bloc d'achat du pack.
 * Paiement : tant que COMMERCE.checkoutEnabled est false, le bouton reste désactivé et le dit
 * clairement (aucun faux bouton de paiement). Branchement prévu : bouton hébergé PayPal
 * (option A) ou API de commandes externe (option B) — voir docs/PAIEMENTS-ET-COMMANDES.md.
 */
import { CAMPAIGN } from "../config/campaign";
import { PACK, SERVICE } from "../config/product";
import { COMMERCE, CONTACT } from "../config/commerce";
import { SITE } from "../config/site";
import Price from "./Price.astro";
import PackList from "./PackList.astro";
import OfferDeadline from "./OfferDeadline.astro";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import Pending from "./Pending.astro";
interface Props { headingLevel?: "h1" | "h2"; id?: string }
const { headingLevel: H = "h2", id = "commander" } = Astro.props;
const hosted = COMMERCE.checkoutEnabled && COMMERCE.provider === "paypal-hosted-button"
  && COMMERCE.paypalHosted.clientId && COMMERCE.paypalHosted.hostedButtonId ? COMMERCE.paypalHosted : null;
---
<div class="buy" id={id}>
  <div class="buy__live">
    {CAMPAIGN.enabled && <p class="buy__eyebrow t-eyebrow">{CAMPAIGN.name}</p>}
    <H class="t-h3 buy__title">{PACK.name}</H>
    <p class="buy__promise">L’oreiller cervical réglable et <strong>2 cadeaux offerts</strong>, pour un seul prix.</p>
    <div class="buy__price">
      <Price size="lg" />
      <p class="buy__ship"><Icon name="truck" size={18} /> {SERVICE.delivery.label}</p>
    </div>

    <PackList />

    <div class="buy__deadline"><OfferDeadline /></div>

    {hosted ? (
      <div class="buy__pay" id="paypal-hosted" data-checkout></div>
    ) : (
      <Button variant="primary" size="lg" block disabled data-offer-action>
        <Icon name="bag" size={18} /> Commander le pack
      </Button>
    )}
    {SITE.preview && !COMMERCE.checkoutEnabled && (
      <p class="buy__preview" role="note">Aperçu : le paiement (PayPal et carte bancaire) sera activé après validation complète en environnement de test.</p>
    )}

    <ul class="buy__reassure" role="list">
      <li><Icon name="truck" size={20} /><span><strong>{SERVICE.delivery.label}</strong> en {SERVICE.delivery.zone}, {SERVICE.delivery.delay}</span></li>
      <li><Icon name="return" size={20} /><span><a href="/garantie-90-jours">90 jours pour changer d’avis</a>, en plus de vos droits légaux</span></li>
      <li><Icon name="lock" size={20} /><span>Paiement sécurisé PayPal ou carte bancaire, sans création de compte<Pending note="Carte bancaire : selon l’éligibilité du compte PayPal" /></span></li>
      <li><Icon name="mail" size={20} /><span>Une question ? <a href="/contact">Écrivez-nous</a></span></li>
    </ul>
  </div>

  <div class="buy__ended" role="status">
    <p class="t-eyebrow">Offre terminée</p>
    <p class="t-h3">L’offre spéciale Pré-Black Friday est terminée.</p>
    <p class="t-muted">Les nouvelles conditions seront affichées ici. Pour toute question : <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>.<Pending note="Offre post-campagne à définir par la marque" /></p>
  </div>
</div>

{hosted && (
  <script is:inline define:vars={{ clientId: hosted.clientId, buttonId: hosted.hostedButtonId }}>
    (function () {
      var s = document.createElement("script");
      s.src = "https://www.paypal.com/sdk/js?client-id=" + encodeURIComponent(clientId) + "&components=hosted-buttons&enable-funding=card&currency=EUR&locale=fr_FR";
      s.onload = function () { window.paypal && window.paypal.HostedButtons({ hostedButtonId: buttonId }).render("#paypal-hosted"); };
      s.onerror = function () { var h = document.getElementById("paypal-hosted"); if (h) h.textContent = "Le paiement sécurisé n’a pas pu se charger. Actualisez la page ou contactez-nous."; };
      document.head.appendChild(s);
    })();
  </script>
)}

<style>
  .buy { display: grid; gap: var(--s-5); }
  .buy__live { display: grid; gap: var(--s-5); }
  .buy__eyebrow { color: var(--c-terre); }
  .buy__title { margin-top: calc(-1 * var(--s-3)); }
  .buy__promise { color: var(--c-encre-douce); margin-top: calc(-1 * var(--s-3)); }
  .buy__promise strong { color: var(--c-encre); font-weight: 600; }
  .buy__price { display: grid; gap: var(--s-2); }
  .buy__ship { display: inline-flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); font-weight: 600; color: var(--c-sauge); }
  .buy__deadline { padding: var(--s-4); border-radius: var(--r-md); background: var(--c-lin); }
  .buy__preview { margin-top: calc(-1 * var(--s-3)); font-size: var(--fs-xs); line-height: 1.5; color: var(--c-terre); }
  .buy__reassure { display: grid; gap: var(--s-3); font-size: var(--fs-sm); line-height: 1.45; }
  .buy__reassure li { display: grid; grid-template-columns: auto 1fr; gap: var(--s-3); align-items: start; }
  .buy__reassure :global(.icon) { color: var(--c-sauge); }
  .buy__reassure a { color: var(--c-encre); }
  .buy__reassure strong { font-weight: 600; }
  .buy__ended { display: none; gap: var(--s-3); padding: var(--s-5); border: var(--hairline); border-radius: var(--r-md); }
  :global(html[data-offer="closed"]) .buy__live { display: none; }
  :global(html[data-offer="closed"]) .buy__ended { display: grid; }
</style>
