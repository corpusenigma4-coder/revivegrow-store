---
/**
 * Paiement — bouton hébergé officiel PayPal (intégration de la PR #15, conservée telle quelle :
 * même identifiant client public, même hostedButtonId, même URL de SDK).
 * Ce composant ajoute seulement : état de chargement, message d'erreur clair, délai d'attente,
 * chargement unique du SDK par page et chargement différé à l'approche du bloc.
 * Le prix, la livraison et l'adresse sont gérés par PayPal ; aucune donnée bancaire ne transite par le site.
 * Aucune confirmation n'est affichée par le site : seule la page PayPal confirme un paiement.
 */
import { COMMERCE, CONTACT } from "../config/commerce";
import Icon from "./Icon.astro";
interface Props { slot?: string; eager?: boolean }
const { slot = "paypal-hosted", eager = false } = Astro.props;
const hosted = COMMERCE.checkoutEnabled && COMMERCE.provider === "paypal-hosted-button"
  && COMMERCE.paypalHosted.clientId && COMMERCE.paypalHosted.hostedButtonId ? COMMERCE.paypalHosted : null;
---
{hosted ? (
  <div class="pp" data-pp data-slot={slot} data-eager={eager ? "1" : "0"}>
    <p class="pp__head"><Icon name="lock" size={16} /> Paiement sécurisé par PayPal</p>
    <div class="pp__slot" id={slot} data-checkout></div>
    <p class="pp__loading" data-pp-loading><span class="pp__spin" aria-hidden="true"></span> Chargement du paiement sécurisé…</p>
    <p class="pp__error" data-pp-error role="alert" hidden>
      Le paiement sécurisé n’a pas pu se charger. Vérifiez votre connexion puis
      <button type="button" class="pp__retry" data-pp-retry>réessayez</button>, ou écrivez-nous à
      <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>.
    </p>
    <p class="pp__note">Vous indiquez votre adresse de livraison et réglez sur la page sécurisée de PayPal. REVIVE GROW n’a jamais accès à vos données bancaires.</p>
  </div>
) : (
  <div class="pp pp--off">
    <button class="pp__disabled" type="button" disabled data-offer-action>Commande bientôt disponible</button>
    <p class="pp__note">Le paiement en ligne ouvre très prochainement. Une question&nbsp;? <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></p>
  </div>
)}

{hosted && (
  <script is:inline define:vars={{ clientId: hosted.clientId, buttonId: hosted.hostedButtonId }}>
    (function () {
      var SDK = "https://www.paypal.com/sdk/js?client-id=" + encodeURIComponent(clientId) + "&components=hosted-buttons&disable-funding=venmo&currency=EUR&locale=fr_FR";
      var w = window;
      function loadSdk() {
        if (w.__rgPayPal) return w.__rgPayPal;
        w.__rgPayPal = new Promise(function (resolve, reject) {
          var s = document.createElement("script");
          s.src = SDK; s.async = true;
          s.onload = function () { w.paypal && w.paypal.HostedButtons ? resolve(w.paypal) : reject(new Error("sdk")); };
          s.onerror = function () { reject(new Error("network")); };
          document.head.appendChild(s);
        });
        return w.__rgPayPal;
      }
      function mount(root) {
        if (root.dataset.state) return;
        root.dataset.state = "loading";
        var slot = root.querySelector("[data-checkout]");
        var loading = root.querySelector("[data-pp-loading]");
        var error = root.querySelector("[data-pp-error]");
        var done = false;
        function fail() { if (done) return; done = true; root.dataset.state = "error"; loading.hidden = true; error.hidden = false; }
        var timer = setTimeout(fail, 20000);
        loadSdk().then(function (pp) {
          return pp.HostedButtons({ hostedButtonId: buttonId }).render("#" + slot.id);
        }).then(function () {
          if (done) return; done = true; clearTimeout(timer);
          root.dataset.state = "ready"; loading.hidden = true;
        }).catch(function () { clearTimeout(timer); fail(); });
      }
      document.querySelectorAll("[data-pp]").forEach(function (root) {
        root.querySelector("[data-pp-retry]").addEventListener("click", function () { location.reload(); });
        if (root.dataset.eager === "1" || !("IntersectionObserver" in w)) return mount(root);
        var io = new IntersectionObserver(function (es) { if (es[0].isIntersecting) { io.disconnect(); mount(root); } }, { rootMargin: "800px 0px" });
        io.observe(root);
      });
    })();
  </script>
)}

<style>
  .pp { display: grid; gap: var(--s-3); padding: var(--s-4); border: 1px solid var(--c-sable); border-radius: var(--r-lg); background: var(--c-blanc); }
  .pp__head { display: inline-flex; align-items: center; gap: var(--s-2); font-size: var(--fs-xs); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--c-sauge); }
  .pp__slot { min-height: 0; }
  .pp[data-state="loading"] .pp__slot, .pp:not([data-state]) .pp__slot { min-height: 50px; }
  .pp__loading { display: flex; align-items: center; justify-content: center; gap: var(--s-3); min-height: 50px; margin-top: -50px; border-radius: var(--r-md); background: var(--c-lin); font-size: var(--fs-sm); color: var(--c-encre-douce); }
  .pp__loading[hidden] { display: none; }
  .pp__spin { width: 16px; height: 16px; border-radius: 50%; border: 2px solid var(--c-sable); border-top-color: var(--c-sauge); animation: pp-spin 0.9s linear infinite; }
  @keyframes pp-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .pp__spin { animation: none; } }
  .pp__error { font-size: var(--fs-sm); line-height: 1.5; color: var(--c-terre); }
  .pp__error a { color: inherit; overflow-wrap: anywhere; }
  .pp__retry { font-weight: 600; text-decoration: underline; color: inherit; min-height: 24px; }
  .pp__note { font-size: var(--fs-xs); line-height: 1.5; color: var(--c-encre-douce); }
  .pp__note a { color: var(--c-encre); overflow-wrap: anywhere; }
  .pp__disabled { width: 100%; min-height: 54px; border-radius: var(--r-pill); background: var(--c-lin); color: var(--c-encre-douce); font-weight: 600; cursor: not-allowed; }
</style>
