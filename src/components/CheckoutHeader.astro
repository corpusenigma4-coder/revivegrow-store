---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
---
<header class="chdr">
  <div class="container chdr__inner">
    <a class="chdr__back" href="/" aria-label="Retour à la boutique"><Icon name="chevron" size={20} class="chdr__chev" /><span class="chdr__backtxt">Boutique</span></a>
    <a href="/" class="chdr__brand" aria-label="REVIVE GROW, retour à l’accueil"><Logo size="sm" /></a>
    <p class="chdr__secure"><Icon name="lock" size={16} /><span>Paiement sécurisé</span></p>
  </div>
</header>
<style>
  .chdr { background: var(--c-ivoire); border-bottom: var(--hairline); }
  .chdr__inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 60px; }
  .chdr__back { display: inline-flex; align-items: center; gap: 4px; min-height: 44px; font-size: var(--fs-sm); text-decoration: none; color: var(--c-encre-douce); }
  .chdr__back :global(.chdr__chev) { transform: rotate(180deg); }
  .chdr__brand { text-decoration: none; }
  .chdr__secure { justify-self: end; display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-xs); font-weight: 600; color: var(--c-sauge); }
  @media (max-width: 420px) { .chdr__backtxt, .chdr__secure span { display: none; } }
</style>
