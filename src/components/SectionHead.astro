---
interface Props { num?: string; eyebrow: string; title: string; lead?: string; align?: "start" | "center"; tone?: "encre" | "ivoire"; id?: string }
const { num, eyebrow, title, lead, align = "start", tone = "encre", id } = Astro.props;
---
<header class:list={["shead", `shead--${align}`, `shead--${tone}`]} data-reveal>
  <p class="shead__eyebrow t-eyebrow">{num && <span class="t-num shead__num">{num}</span>}{eyebrow}</p>
  <h2 class="t-h2" id={id}>{title}</h2>
  {lead && <p class="t-lead shead__lead">{lead}</p>}
</header>
<style>
  .shead { display: grid; gap: var(--s-4); max-width: 46rem; margin-bottom: clamp(2rem, 1.4rem + 2.4vw, 3.5rem); }
  .shead--center { margin-inline: auto; text-align: center; justify-items: center; }
  .shead__eyebrow { display: inline-flex; align-items: baseline; gap: 0.75em; }
  .shead__num { font-size: 1.15rem; letter-spacing: 0; text-transform: none; color: var(--c-encre-douce); }
  .shead--ivoire .shead__eyebrow { color: var(--c-sauge-claire); }
  .shead--ivoire .shead__num, .shead--ivoire .shead__lead { color: rgb(247 243 236 / 0.72); }
</style>
