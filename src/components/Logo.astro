---
/** Logo officiel REVIVE GROW (fichier fourni par la marque, fond rendu transparent). */
interface Props { tone?: "encre" | "ivoire"; size?: "sm" | "md" | "lg" }
const { tone = "encre", size = "md" } = Astro.props;
const src = tone === "ivoire" ? "/logo-revivegrow-clair.webp" : "/logo-revivegrow.webp";
---
<img class:list={["logo", `logo--${size}`]} src={src} alt="REVIVE GROW" width="1200" height="288" decoding="async" />
<style>
  .logo { display: block; width: auto; max-width: 100%; }
  .logo--sm { height: 30px; }
  .logo--md { height: clamp(32px, 6vw + 10px, 42px); }
  .logo--lg { height: 64px; }
</style>
