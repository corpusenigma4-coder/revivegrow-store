---
/**
 * Galerie produit : défilement tactile (scroll-snap), points, miniatures, flèches,
 * et visionneuse plein écran (« Touchez pour agrandir ») pour lire les visuels d'information.
 * Une seule visionneuse par galerie ; Échap, croix ou geste retour pour fermer.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
interface Item { src: ImageMetadata; alt: string; fit?: "cover" | "contain" }
interface Props { images: Item[]; variant?: "hero" | "pdp"; id: string; eager?: boolean }
const { images, variant = "hero", id, eager = false } = Astro.props;
const sizes = variant === "hero" ? "(min-width: 960px) 52vw, 100vw" : "(min-width: 960px) 55vw, 100vw";
---
<div class:list={["mg", `mg--${variant}`]} data-mg id={id}>
  <div class="mg__stage">
    <ul class="mg__track" role="list" data-mg-track aria-label="Photos du produit">
      {images.map((im, i) => (
        <li class="mg__slide">
          <button type="button" class="mg__open" data-mg-open={i} aria-label={`Agrandir l’image ${i + 1} sur ${images.length} : ${im.alt}`}>
            <Image src={im.src} alt={im.alt} widths={[480, 800, 1254].filter((w) => w <= im.src.width)} sizes={sizes} quality={82}
              loading={eager && i === 0 ? "eager" : "lazy"} fetchpriority={eager && i === 0 ? "high" : undefined}
              class:list={["mg__img", im.fit === "contain" && "mg__img--contain"]} draggable="false" />
          </button>
        </li>
      ))}
    </ul>
    <slot />
    <button type="button" class="mg__nav mg__nav--prev" data-mg-prev aria-label="Image précédente"><Icon name="chevron" size={20} /></button>
    <button type="button" class="mg__nav mg__nav--next" data-mg-next aria-label="Image suivante"><Icon name="chevron" size={20} /></button>
    <span class="mg__zoom" aria-hidden="true"><Icon name="plus" size={14} /> Agrandir</span>
  </div>
  <div class="mg__thumbs" role="tablist" aria-label="Choisir une image">
    {images.map((im, i) => (
      <button type="button" class="mg__thumb" role="tab" data-mg-go={i} aria-selected={i === 0 ? "true" : "false"} aria-label={`Image ${i + 1} : ${im.alt}`}>
        <Image src={im.src} alt="" widths={[160]} sizes="72px" quality={70} class="mg__timg" loading="lazy" />
      </button>
    ))}
  </div>

  <dialog class="lb" data-mg-dialog aria-label="Visionneuse d’images">
    <div class="lb__bar">
      <span class="lb__count t-tabular" data-mg-count>1 / {images.length}</span>
      <button type="button" class="lb__close" data-mg-close aria-label="Fermer la visionneuse"><Icon name="close" size={24} /></button>
    </div>
    <ul class="lb__track" role="list" data-mg-lbtrack>
      {images.map((im) => (
        <li class="lb__slide">
          <Image src={im.src} alt={im.alt} widths={[800, 1254, 1672].filter((w) => w <= im.src.width)} sizes="100vw" quality={88} loading="lazy" class="lb__img" draggable="false" />
        </li>
      ))}
    </ul>
    <button type="button" class="lb__nav lb__nav--prev" data-mg-lbprev aria-label="Image précédente"><Icon name="chevron" size={24} /></button>
    <button type="button" class="lb__nav lb__nav--next" data-mg-lbnext aria-label="Image suivante"><Icon name="chevron" size={24} /></button>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-mg]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-mg-track]")!;
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-mg-go]"));
    const dlg = root.querySelector<HTMLDialogElement>("[data-mg-dialog]")!;
    const lbt = root.querySelector<HTMLElement>("[data-mg-lbtrack]")!;
    const count = root.querySelector<HTMLElement>("[data-mg-count]")!;
    const n = thumbs.length;
    const idx = (el: HTMLElement) => Math.round(el.scrollLeft / Math.max(1, el.clientWidth));
    const go = (el: HTMLElement, i: number, smooth = true) => el.scrollTo({ left: Math.max(0, Math.min(n - 1, i)) * el.clientWidth, behavior: smooth && !matchMedia("(prefers-reduced-motion: reduce)").matches ? "smooth" : "auto" });
    const sync = () => {
      const i = idx(track);
      root.dataset.index = String(i);
      thumbs.forEach((t, k) => t.setAttribute("aria-selected", String(k === i)));
      const t = thumbs[i], tc = t?.parentElement;
      if (t && tc && tc.scrollWidth > tc.clientWidth) tc.scrollTo({ left: t.offsetLeft - (tc.clientWidth - t.clientWidth) / 2 });
    };
    let raf = 0;
    track.addEventListener("scroll", () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(sync); }, { passive: true });
    thumbs.forEach((t, k) => t.addEventListener("click", () => go(track, k)));
    root.querySelector("[data-mg-prev]")?.addEventListener("click", () => go(track, idx(track) - 1));
    root.querySelector("[data-mg-next]")?.addEventListener("click", () => go(track, idx(track) + 1));

    // Visionneuse plein écran
    const lbSync = () => { count.textContent = `${idx(lbt) + 1} / ${n}`; };
    lbt.addEventListener("scroll", () => requestAnimationFrame(lbSync), { passive: true });
    root.querySelectorAll<HTMLButtonElement>("[data-mg-open]").forEach((b) => b.addEventListener("click", () => {
      const i = Number(b.dataset.mgOpen);
      lbt.querySelectorAll<HTMLImageElement>("img").forEach((im) => { im.loading = "eager"; });
      dlg.showModal();
      document.body.classList.add("is-locked");
      go(lbt, i, false); lbSync();
    }));
    const close = () => { if (dlg.open) dlg.close(); };
    dlg.addEventListener("close", () => { document.body.classList.remove("is-locked"); go(track, idx(lbt), false); });
    root.querySelector("[data-mg-close]")?.addEventListener("click", close);
    root.querySelector("[data-mg-lbprev]")?.addEventListener("click", () => go(lbt, idx(lbt) - 1));
    root.querySelector("[data-mg-lbnext]")?.addEventListener("click", () => go(lbt, idx(lbt) + 1));
    dlg.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { e.preventDefault(); go(lbt, idx(lbt) + 1); }
      if (e.key === "ArrowLeft") { e.preventDefault(); go(lbt, idx(lbt) - 1); }
    });
    sync();
  });
</script>

<style>
  .mg { display: grid; gap: var(--s-3); min-width: 0; }
  .mg__stage { position: relative; }
  .mg__track { display: grid; grid-auto-flow: column; grid-auto-columns: 100%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; border-radius: var(--r-lg); background: var(--c-studio); -webkit-overflow-scrolling: touch; }
  .mg__track::-webkit-scrollbar { display: none; }
  .mg__slide { scroll-snap-align: start; scroll-snap-stop: always; }
  .mg__open { display: block; width: 100%; padding: 0; cursor: zoom-in; -webkit-tap-highlight-color: transparent; }
  .mg__img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; }
  .mg__img--contain { object-fit: contain; }
  @media (max-width: 959px) { .mg--hero .mg__track { border-radius: 0; margin-inline: calc(-1 * var(--gutter)); } }

  .mg__nav { position: absolute; top: 50%; translate: 0 -50%; display: none; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: rgb(255 253 249 / 0.92); color: var(--c-encre); box-shadow: var(--shadow-soft); transition: opacity var(--dur) var(--ease); }
  .mg__nav--prev { left: var(--s-3); } .mg__nav--prev :global(.icon) { rotate: 180deg; }
  .mg__nav--next { right: var(--s-3); }
  @media (hover: hover) and (min-width: 960px) { .mg__nav { display: grid; opacity: 0; } .mg__stage:hover .mg__nav { opacity: 1; } }
  .mg[data-index="0"] .mg__nav--prev { visibility: hidden; }

  .mg__zoom { position: absolute; right: var(--s-3); bottom: var(--s-3); display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: var(--r-pill); background: rgb(34 32 28 / 0.62); color: var(--c-ivoire); font-size: 0.75rem; font-weight: 600; pointer-events: none; }
  @media (max-width: 959px) { .mg--hero .mg__zoom { right: 0; } }

  .mg__thumbs { display: flex; gap: var(--s-2); overflow-x: auto; scrollbar-width: none; padding: 2px; }
  .mg__thumbs::-webkit-scrollbar { display: none; }
  .mg__thumb { flex: none; width: 64px; height: 64px; padding: 0; border-radius: var(--r-sm); overflow: hidden; border: 2px solid transparent; opacity: 0.7; transition: opacity var(--dur) var(--ease), border-color var(--dur) var(--ease); }
  .mg__thumb[aria-selected="true"] { border-color: var(--c-encre); opacity: 1; }
  .mg__timg { width: 100%; height: 100%; object-fit: cover; }
  @media (min-width: 960px) { .mg__thumb { width: 72px; height: 72px; } }

  /* Visionneuse */
  .lb { width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; margin: 0; padding: 0; border: 0; background: #12141A; color: var(--c-ivoire); }
  .lb[open] { display: grid; grid-template-rows: auto 1fr; }
  .lb::backdrop { background: rgb(18 20 26 / 0.92); }
  .lb__bar { display: flex; align-items: center; justify-content: space-between; padding: calc(var(--s-2) + env(safe-area-inset-top)) var(--s-4) var(--s-2); }
  .lb__count { font-size: var(--fs-sm); opacity: 0.8; }
  .lb__close { display: grid; place-items: center; width: 48px; height: 48px; color: var(--c-ivoire); }
  .lb__track { display: grid; grid-auto-flow: column; grid-auto-columns: 100%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior: contain; min-height: 0; }
  .lb__track::-webkit-scrollbar { display: none; }
  .lb__slide { scroll-snap-align: start; scroll-snap-stop: always; display: grid; place-items: center; padding: var(--s-2) var(--s-2) calc(var(--s-4) + env(safe-area-inset-bottom)); min-height: 0; }
  .lb__img { width: auto; height: auto; max-width: 100%; max-height: calc(100dvh - 90px); object-fit: contain; border-radius: var(--r-sm); }
  .lb__nav { position: absolute; top: 50%; translate: 0 -50%; display: none; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: rgb(255 255 255 / 0.12); color: var(--c-ivoire); }
  .lb__nav--prev { left: var(--s-4); } .lb__nav--prev :global(.icon) { rotate: 180deg; }
  .lb__nav--next { right: var(--s-4); }
  @media (min-width: 960px) { .lb__nav { display: grid; } }
</style>
