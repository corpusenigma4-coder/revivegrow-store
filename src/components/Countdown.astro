---
/**
 * Compte à rebours réel — rendu UNIQUEMENT si une date de fin est configurée.
 * Sans JavaScript, la date de fin (toujours exacte) reste affichée ailleurs.
 */
import { CAMPAIGN } from "../config/campaign";
interface Props { variant?: "inline" | "block"; tone?: "encre" | "ivoire" }
const { variant = "inline", tone = "encre" } = Astro.props;
const end = CAMPAIGN.endsAt;
---
{end && (
  <span class:list={["cd", `cd--${variant}`, `cd--${tone}`]} data-countdown hidden>
    <span class="cd__label">Fin dans</span>
    <time class="cd__value t-tabular" datetime={end} data-countdown-text>—</time>
  </span>
)}
<style>
  .cd { display: inline-flex; align-items: baseline; gap: 0.45em; }
  .cd[hidden] { display: none; }
  .cd__label { font-size: 0.8em; opacity: 0.8; }
  .cd__value { font-weight: 600; letter-spacing: 0.01em; }
</style>
