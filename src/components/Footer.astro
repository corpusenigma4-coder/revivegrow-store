---
import { Image } from "astro:assets";
import logo from "../assets/img/logo.webp";
import { TIENDA, enlaceWhatsApp, MENSAJE_CONSULTA } from "../config/tienda";
import { CATALOGO, type ProductoVenta } from "../config/catalogo";
import { ruta } from "../lib/ruta";
interface Props { producto?: ProductoVenta }
const { producto } = Astro.props;
const fichas = producto ? [producto.ficha] : Object.values(CATALOGO).map((p) => p.ficha);
const mensaje = producto?.mensajeConsulta ?? MENSAJE_CONSULTA;
const e = TIENDA.empresa;
const anio = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="stack">
        <span class="footer__logo"><Image src={logo} alt="REVIVE GROW" height={30} widths={[125, 250]} sizes="125px" /></span>
        <p>Tienda en línea en Ecuador. Pedidos con pago contra entrega y atención por WhatsApp.</p>
        <p>
          <a href={enlaceWhatsApp(mensaje)} target="_blank" rel="noopener">WhatsApp {TIENDA.whatsapp.visible}</a>
          {e.horarioAtencion && <><br />{e.horarioAtencion}</>}
        </p>
      </div>
      <nav aria-labelledby="pie-info">
        <h2 id="pie-info">Información</h2>
        <ul>
          <li><a href={ruta("/envios/")}>Envíos y entregas</a></li>
          <li><a href={ruta("/devoluciones/")}>Cambios y devoluciones</a></li>
          <li><a href={ruta("/terminos/")}>Términos y condiciones</a></li>
          <li><a href={ruta("/privacidad/")}>Política de privacidad</a></li>
          <li><a href={ruta("/contacto/")}>Contacto</a></li>
        </ul>
      </nav>
      <div>
        <h2>Vendedor</h2>
        <ul>
          <li>{e.razonSocial ?? <span>REVIVE GROW</span>}</li>
          {e.ruc && <li>RUC {e.ruc}</li>}
          {e.domicilio && <li>{e.domicilio}</li>}
          {fichas.map((f) => <li>{fichas.length > 1 ? `${f.nombre} — marca` : "Marca del producto"}: {f.marca}{f.fabricante && ` · Fabricante: ${f.fabricante}`}</li>)}
          {TIENDA.sanitario.notificacionSanitaria && <li>Notificación Sanitaria: {TIENDA.sanitario.notificacionSanitaria}</li>}
        </ul>
      </div>
    </div>
    <div class="footer__legal">
      <p>
        {producto ? `${producto.ficha.nombre} es un suplemento alimenticio para adultos. No es un medicamento y no está destinado` : "Los productos de esta tienda son suplementos alimenticios para adultos. No son medicamentos y no están destinados"} a diagnosticar, tratar, curar ni prevenir
        enfermedades. {producto ? "No reemplaza" : "No reemplazan"} una alimentación variada y equilibrada ni un estilo de vida saludable. Consulta a tu médico si tomas
        medicamentos o tienes alguna condición de salud.
      </p>
      <p>REVIVE GROW comercializa {producto ? "este producto" : "estos productos"}; no es su fabricante ni el titular de la marca. Las marcas y etiquetas del producto pertenecen a sus titulares.</p>
      <p>© {anio} REVIVE GROW · Ecuador</p>
    </div>
  </div>
</footer>
