---
import { Image } from "astro:assets";
import { PACK, PILLOW, MASK, STRIPS } from "../config/product";
import { CAMPAIGN } from "../config/campaign";
import { formatPrice } from "../lib/format";
import imgPillow from "../assets/images/oreiller-couches.webp";
import imgMask from "../assets/images/masque-pack.webp";
import imgStrips from "../assets/images/bandelettes-pack.webp";
interface Props { tone?: "encre" | "ivoire"; compact?: boolean }
const { tone = "encre", compact = false } = Astro.props;
const rows = [
  { img: imgPillow, name: PILLOW.name, sub: "Hauteur réglable", gift: false },
  { img: imgMask, name: MASK.name, sub: `Coloris ${MASK.color.toLowerCase()}`, gift: true },
  { img: imgStrips, name: STRIPS.name, sub: "Pose externe sur le nez", gift: true },
];
---
<div class:list={["pack", `pack--${tone}`, compact && "pack--compact"]}>
  <ul class="pack__list" role="list" aria-label={`Contenu du ${PACK.name}`}>
    {rows.map((r) => (
      <li class="pack__row">
        <Image src={r.img} alt="" width={128} height={96} class="pack__img" loading="lazy" />
        <span class="pack__txt">
          <span class="pack__name">{r.name}</span>
          <span class="pack__sub">{r.sub}</span>
        </span>
        <span class:list={["pack__tag", r.gift ? "pack__tag--gift" : "pack__tag--main"]}>{r.gift ? "Offert" : "× 1"}</span>
      </li>
    ))}
  </ul>
  <p class="pack__total">
    <span>Les trois articles, livrés ensemble</span>
    <strong class="t-tabular">{formatPrice(CAMPAIGN.price)}</strong>
  </p>
</div>
<style>
  .pack__list { display: grid; }
  .pack__row { display: grid; grid-template-columns: 64px 1fr auto; align-items: center; gap: var(--s-4); padding-block: var(--s-3); border-bottom: var(--hairline); }
  .pack__img { width: 64px; height: 48px; object-fit: cover; border-radius: var(--r-sm); background: var(--c-lin); }
  .pack__txt { display: grid; line-height: 1.3; }
  .pack__name { font-weight: 600; font-size: 0.9375rem; }
  .pack__sub { font-size: var(--fs-sm); color: var(--c-encre-douce); }
  .pack__tag { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; white-space: nowrap; }
  .pack__tag--gift { padding: 3px 10px; border-radius: var(--r-pill); background: var(--c-sauge-pale); color: var(--c-sauge); text-transform: uppercase; }
  .pack__tag--main { color: var(--c-encre-douce); }
  .pack__total { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-4); padding-top: var(--s-4); font-size: var(--fs-sm); color: var(--c-encre-douce); }
  .pack__total strong { font-size: 1.0625rem; color: var(--c-encre); }
  .pack--ivoire .pack__row { border-color: rgb(247 243 236 / 0.14); }
  .pack--ivoire .pack__sub, .pack--ivoire .pack__total, .pack--ivoire .pack__tag--main { color: rgb(247 243 236 / 0.7); }
  .pack--ivoire .pack__total strong { color: var(--c-ivoire); }
  .pack--ivoire .pack__tag--gift { background: rgb(181 190 169 / 0.18); color: var(--c-sauge-claire); }
</style>
