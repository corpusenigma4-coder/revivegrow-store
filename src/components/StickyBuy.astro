---
/** Barre d'achat mobile : apparaît après le premier écran, s'efface près du bloc d'achat. */
import { CAMPAIGN } from "../config/campaign";
import { formatPrice } from "../lib/format";
interface Props { target?: string }
const { target = "/oreiller-cervical-ajustable#commander" } = Astro.props;
---
<div class="sticky" data-sticky aria-hidden="true" inert>
  <div class="sticky__txt">
    <span class="sticky__price t-tabular">{formatPrice(CAMPAIGN.price)}</span>
    <span class="sticky__sub">Oreiller + 2 cadeaux offerts</span>
  </div>
  <a class="sticky__btn" href={target}>Voir le pack</a>
</div>
<script>
  const bar = document.querySelector<HTMLElement>("[data-sticky]");
  const hero = document.querySelector("[data-hero]");
  const buy = document.querySelector("#commander");
  if (bar && hero) {
    let pastHero = false, nearBuy = false;
    const update = () => {
      const show = pastHero && !nearBuy && document.documentElement.dataset.phase !== "ended";
      bar.classList.toggle("is-on", show);
      bar.toggleAttribute("inert", !show);
      bar.setAttribute("aria-hidden", String(!show));
    };
    new IntersectionObserver(([e]) => { pastHero = !e.isIntersecting && e.boundingClientRect.top < 0; update(); }).observe(hero);
    if (buy) new IntersectionObserver(([e]) => { nearBuy = e.isIntersecting; update(); }, { rootMargin: "0px 0px -20% 0px" }).observe(buy);
  }
</script>
<style>
  .sticky {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
    display: flex; align-items: center; justify-content: space-between; gap: var(--s-4);
    padding: var(--s-3) var(--gutter) calc(var(--s-3) + env(safe-area-inset-bottom));
    background: rgb(255 253 249 / 0.96); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-top: var(--hairline); box-shadow: 0 -8px 24px -16px rgb(34 32 28 / 0.25);
    transform: translateY(110%); transition: transform var(--dur) var(--ease);
  }
  .sticky.is-on { transform: none; }
  .sticky__txt { display: grid; line-height: 1.2; }
  .sticky__price { font-family: var(--f-serif); font-size: 1.5rem; font-weight: 600; }
  .sticky__sub { font-size: var(--fs-xs); color: var(--c-encre-douce); }
  .sticky__btn { display: inline-flex; align-items: center; min-height: 48px; padding: 0 1.5em; border-radius: var(--r-pill); background: var(--c-encre); color: var(--c-ivoire); font-weight: 600; font-size: 0.9375rem; text-decoration: none; }
  @media (min-width: 960px) { .sticky { display: none; } }
</style>
