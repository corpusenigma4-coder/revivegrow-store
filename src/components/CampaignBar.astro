---
import { CAMPAIGN } from "../config/campaign";
import { formatParisDayMonth } from "../lib/format";
import Countdown from "./Countdown.astro";
const until = formatParisDayMonth(CAMPAIGN.endsAt);
---
<div class="cbar" role="region" aria-label="Offre en cours">
  <div class="container cbar__inner">
    <p class="cbar__live">
      <span class="cbar__name"><span class="cbar__hide-sm">Offre </span>Pré-Black Friday</span>
      <span class="cbar__dot" aria-hidden="true"></span>
      <span>2 cadeaux offerts</span>
      <span class="cbar__dot cbar__hide-sm" aria-hidden="true"></span>
      <span class="cbar__hide-sm">jusqu’au {until} à 23&nbsp;h&nbsp;59</span>
    </p>
    <p class="cbar__ended" data-phase-message="status"></p>
    <span class="cbar__cd"><Countdown tone="ivoire" /></span>
  </div>
</div>
<style>
  .cbar { background: var(--c-nuit); color: var(--c-ivoire); font-size: 0.8125rem; letter-spacing: 0.02em; }
  .cbar__inner { display: flex; align-items: center; justify-content: center; gap: var(--s-3) var(--s-4); min-height: 40px; padding-block: 6px; text-align: center; white-space: nowrap; }
  .cbar__live { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.55em; }
  .cbar__name { font-weight: 600; }
  .cbar__dot { width: 3px; height: 3px; border-radius: 50%; background: var(--c-sable); }
  .cbar__ended { display: none; }
  .cbar__cd { color: var(--c-sable); }
  @media (max-width: 719px) {
    .cbar { font-size: 0.75rem; letter-spacing: 0.01em; }
    .cbar__cd :global(.cd__label) { display: none; }
  }
  @media (max-width: 719px) { .cbar__hide-sm { display: none; } }
  :global(html[data-phase="ended"]) .cbar__live,
  :global(html[data-phase="upcoming"]) .cbar__live { display: none; }
  :global(html[data-phase="ended"]) .cbar__ended,
  :global(html[data-phase="upcoming"]) .cbar__ended { display: block; }
</style>
