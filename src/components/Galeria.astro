---
/**
 * Galería deslizable del producto (scroll-snap nativo: funciona con el dedo, sin librerías).
 * Primera imagen con prioridad de carga; el resto, diferidas. Las imágenes se muestran completas
 * (sin recortar sus textos) sobre el color de fondo de cada una.
 */
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";

interface Diapositiva { src: ImageMetadata; alt: string; fondo: string }
interface Props { diapositivas: Diapositiva[]; etiqueta: string }
const { diapositivas, etiqueta } = Astro.props;
---
<div class="gal" data-galeria role="region" aria-roledescription="carrusel" aria-label={etiqueta}>
  <div class="gal__track" data-gal-track tabindex="0">
    {diapositivas.map((d, i) => (
      <div class="gal__slide" style={`background:${d.fondo}`} role="group" aria-roledescription="imagen" aria-label={`${i + 1} de ${diapositivas.length}`}>
        <Picture
          src={d.src}
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={[480, 760, 1100]}
          quality={80}
          sizes="(min-width: 920px) 560px, 100vw"
          alt={d.alt}
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : "auto"}
        />
        {i === 0 && <slot name="primera" />}
      </div>
    ))}
  </div>
  <button type="button" class="gal__nav gal__nav--prev" data-gal-prev aria-label="Imagen anterior"><Icon name="chevron" size={22} /></button>
  <button type="button" class="gal__nav gal__nav--next" data-gal-next aria-label="Imagen siguiente"><Icon name="chevron" size={22} /></button>
  <div class="gal__dots" aria-hidden="true">
    {diapositivas.map((_, i) => <span data-gal-dot class:list={{ "is-on": i === 0 }}></span>)}
  </div>
  <span class="gal__hint" aria-hidden="true">Desliza <Icon name="arrow" size={14} /></span>
</div>

<style>
  .gal { position: relative; }
  .gal__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -webkit-overflow-scrolling: touch; border-radius: inherit; }
  .gal__track::-webkit-scrollbar { display: none; }
  .gal__slide { position: relative; flex: 0 0 100%; scroll-snap-align: start; display: grid; place-items: center; }
  .gal__slide :global(img) { width: 100%; aspect-ratio: 1 / 1; object-fit: contain; display: block; }
  .gal__dots { position: absolute; left: 50%; bottom: 0.6rem; transform: translateX(-50%); display: flex; gap: 6px; padding: 5px 8px; border-radius: 999px; background: rgb(15 26 51 / 0.45); }
  .gal__dots span { width: 7px; height: 7px; border-radius: 50%; background: rgb(255 255 255 / 0.55); transition: background 0.2s, width 0.2s; }
  .gal__dots span.is-on { background: #fff; width: 18px; border-radius: 4px; }
  .gal__nav { position: absolute; top: 50%; transform: translateY(-50%); width: 40px; height: 40px; border-radius: 50%; border: 0; background: rgb(255 255 255 / 0.92); box-shadow: 0 4px 14px -6px rgb(0 0 0 / 0.4); display: none; place-items: center; cursor: pointer; color: var(--ink); }
  .gal__nav--prev { left: 0.6rem; }
  .gal__nav--prev :global(svg) { transform: rotate(90deg); }
  .gal__nav--next { right: 0.6rem; }
  .gal__nav--next :global(svg) { transform: rotate(-90deg); }
  @media (hover: hover) and (min-width: 720px) { .gal__nav { display: grid; } .gal__hint { display: none; } }
  .gal__hint { position: absolute; right: 0.6rem; bottom: 0.55rem; display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.72rem; font-weight: 700; color: #fff; background: rgb(15 26 51 / 0.55); padding: 0.25rem 0.55rem; border-radius: 999px; }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-galeria]").forEach((g) => {
    const track = g.querySelector<HTMLElement>("[data-gal-track]")!;
    const dots = [...g.querySelectorAll<HTMLElement>("[data-gal-dot]")];
    const total = dots.length;
    const actual = () => Math.round(track.scrollLeft / track.clientWidth);
    const ir = (i: number) => track.scrollTo({ left: Math.max(0, Math.min(total - 1, i)) * track.clientWidth, behavior: "smooth" });
    track.addEventListener("scroll", () => {
      const i = actual();
      dots.forEach((d, k) => d.classList.toggle("is-on", k === i));
      g.querySelector<HTMLElement>(".gal__hint")?.remove();
    }, { passive: true });
    g.querySelector("[data-gal-prev]")?.addEventListener("click", () => ir(actual() - 1));
    g.querySelector("[data-gal-next]")?.addEventListener("click", () => ir(actual() + 1));
    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { e.preventDefault(); ir(actual() + 1); }
      if (e.key === "ArrowLeft") { e.preventDefault(); ir(actual() - 1); }
    });
  });
</script>
