---
import { Picture, getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import PackSelector from "../components/PackSelector.astro";
import OrderDialog from "../components/OrderDialog.astro";
import Galeria from "../components/Galeria.astro";
import frasco from "../assets/img/testo-gh-frasco.webp";
import rutinaEmpieza from "../assets/img/testo/rutina-empieza.webp";
import etiqueta from "../assets/img/testo/etiqueta.webp";
import contiene from "../assets/img/testo/contiene.webp";
import botanicos from "../assets/img/testo/botanicos.webp";
import buenaRutina from "../assets/img/testo/buena-rutina.webp";
import { PAQUETES, PAQUETE_INICIAL, TIENDA, enlaceWhatsApp, MENSAJE_CONSULTA } from "../config/tienda";
import { PRODUCTO, DURACION, textoDuracion } from "../config/producto";
import { ahorroPaquete, costoPorDiaCentavos, formatoUSD, paquetePorId } from "../lib/pedido";
import { FAQ } from "../data/faq";
import { ruta } from "../lib/ruta";
import { CATALOGO } from "../config/catalogo";

const testo = CATALOGO["testo-gh"];
const dos = paquetePorId("dos")!;
const uno = paquetePorId("uno")!;
const ahorro = ahorroPaquete(dos);
const inicial = paquetePorId(PAQUETE_INICIAL)!;
const waPedido = enlaceWhatsApp("Hola REVIVE GROW, quiero hacer un pedido de TESTO-GH con pago contra entrega.");
const formas = TIENDA.pago.formasAlRecibir;
const dias = DURACION?.diasPorFrasco ?? 30;
const porDia = costoPorDiaCentavos(dos, testo.diasPorFrasco);
const zoomEtiqueta = await getImage({ src: etiqueta, format: "webp", width: 1024 });

/** Composición de la etiqueta posterior, en dos grupos. */
const porNombre = (n: string) => PRODUCTO.activos.find((a) => a.nombre.startsWith(n))!;
const vitaminas = ["Vitamina D3", "Vitamina B6", "Vitamina B12", "Zinc", "Magnesio"].map(porNombre);
const botanicosLista = [
  { a: porNombre("Ácido D-aspártico"), t: "Aminoácido: es el componente con mayor cantidad por porción." },
  { a: porNombre("Fenogreco"), t: "Semilla de uso tradicional en la cocina de la India y el Mediterráneo; extracto con 50 % de saponinas." },
  { a: porNombre("Tribulus"), t: "Extracto de Tribulus terrestris, planta de flores amarillas." },
  { a: porNombre("Ashwagandha"), t: "Extracto de raíz de ashwagandha (Withania somnifera), planta de la tradición ayurvédica." },
  { a: porNombre("Extracto de maca"), t: "Raíz andina, parte de la alimentación tradicional de los Andes." },
];

const titulo = "TESTO-GH Multi Vitamin For Men | Pago contra entrega en Ecuador · REVIVE GROW";
const descripcion = `TESTO-GH de ${PRODUCTO.marca}: vitaminas, minerales y extractos botánicos en 2 cápsulas al día. ${PRODUCTO.capsulasPorFrasco} cápsulas (${dias} días). 2 frascos por ${formatoUSD(dos.precioCentavos)} (ahorras ${formatoUSD(ahorro.ahorroCentavos)}). Pagas al recibir.`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: PRODUCTO.nombreCompleto,
    description: `${PRODUCTO.tipo}, ${PRODUCTO.capsulasPorFrasco} cápsulas.`,
    image: new URL(ruta("/og-revivegrow-ec.jpg"), Astro.site ?? TIENDA.url).href,
    brand: { "@type": "Brand", name: PRODUCTO.marca },
    offers: PAQUETES.map((p) => ({
      "@type": "Offer",
      name: p.nombre,
      price: (p.precioCentavos / 100).toFixed(2),
      priceCurrency: "USD",
      availability: "https://schema.org/LimitedAvailability",
      areaServed: "EC",
      seller: { "@type": "Organization", name: "REVIVE GROW" },
    })),
  },
];
const fotoProps = { src: frasco, formats: ["avif", "webp"] as const, fallbackFormat: "webp" as const, quality: 80, widths: [480, 760, 1024] };
const imgProps = { formats: ["avif", "webp"] as const, fallbackFormat: "webp" as const, quality: 78, widths: [480, 760, 1100] };
---
<Base title={titulo} description={descripcion} jsonLd={jsonLd} producto={testo}>
  <!-- ============================================================ HERO + OFERTA -->
  <section class="hero" aria-labelledby="titulo-producto">
    <div class="container hero__grid">
      <figure class="hero__media hero__media--studio hero__media--galeria">
        <Galeria
          etiqueta="Fotos de TESTO-GH"
          diapositivas={[
            { src: frasco, alt: "Frasco de TESTO-GH Multi Vitamin For Men, 60 cápsulas", fondo: "#fdfdfd" },
            { src: rutinaEmpieza, alt: "TESTO-GH, multivitamínico para hombres de 60 cápsulas, sobre un pedestal", fondo: "#011333" },
            { src: etiqueta, alt: "Etiqueta posterior de TESTO-GH con la información nutricional, el modo de uso y las advertencias", fondo: "#fefefe" },
          ]}
        >
          <Fragment slot="primera">
            <span class="hero__price">2 frascos · {formatoUSD(dos.precioCentavos)} <small>Ahorras {formatoUSD(ahorro.ahorroCentavos)}</small></span>
          </Fragment>
        </Galeria>
      </figure>

      <div class="buy" id="comprar">
        <span class="eyebrow">{PRODUCTO.marca}</span>
        <h1 id="titulo-producto">TESTO-GH <span>Multivitamínico para hombres · {PRODUCTO.capsulasPorFrasco} cápsulas</span></h1>
        <p class="buy__lead">
          Vitaminas, minerales y extractos botánicos en <strong>2 cápsulas al día</strong>. Pídelo hoy y <strong>pagas cuando lo recibes</strong>.
        </p>
        <ul class="chips" aria-label="Datos clave">
          <li class="chip"><Icon name="capsule" size={16} /> 10 ingredientes</li>
          <li class="chip"><Icon name="clock" size={16} /> {dias} días por frasco</li>
          <li class="chip"><Icon name="user" size={16} /> Para hombres</li>
        </ul>

        <PackSelector grupo="hero" />
        <p class="pack-note" data-aviso-paquete hidden></p>

        <a class="btn btn--cta btn--lg btn--block" href={waPedido} data-abrir-pedido data-oculta-barra>
          <span class="btn-stack">PEDIR AHORA — PAGA AL RECIBIR<span class="sub"><span data-sel-nombre>{inicial.nombre}</span> · <span data-sel-precio>{formatoUSD(inicial.precioCentavos)}</span></span></span>
        </a>

        <ul class="trust">
          <li><Icon name="cash" /> <div>Pagas al recibir <span>— sin tarjeta ni pagos por adelantado.</span></div></li>
          <li><Icon name="whatsapp" /> <div>Confirmación por WhatsApp <span>— te escribimos antes de enviar.</span></div></li>
          <li><Icon name="shield" /> <div>Frasco con sello de seguridad <span>— verifícalo al recibir.</span></div></li>
        </ul>

        <p class="stock" data-stock role="status">
          <Icon name="clock" size={20} />
          <span data-stock-texto><span class="stock__count" data-stock-cifra></span>Unidades limitadas · Oferta sujeta a disponibilidad.</span>
        </p>
        {DURACION && (
          <p class="small">
            {DURACION.fuente === "etiqueta"
              ? `* Duración calculada con la dosis de la etiqueta: 2 cápsulas al día, ${DURACION.diasPorFrasco} días por frasco.`
              : "* Duración aproximada indicada por el proveedor (60 cápsulas para un mes). Sigue siempre el modo de uso impreso en el frasco."}
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- ============================================================ LO QUE CONTIENE -->
  <section class="section section--white" id="formula" aria-labelledby="t-formula">
    <div class="container">
      <div class="head" data-reveal>
        <span class="eyebrow">Lo que contiene</span>
        <h2 id="t-formula">10 ingredientes en 2 cápsulas al día</h2>
        <p class="lead">Cantidades por porción diaria, tal como figuran en la etiqueta del frasco.</p>
      </div>

      <div class="mix" data-reveal>
        <div class="mix__img"><Picture src={contiene} {...imgProps} sizes="(min-width: 920px) 520px, 100vw" alt="TESTO-GH: vitaminas D3, B6 y B12; minerales zinc y magnesio" loading="lazy" /></div>
        <div class="mix__body">
          <h3>Vitaminas y minerales</h3>
          <ul class="rows">
            {vitaminas.map((a) => <li><span>{a.nombre}</span><b>{a.cantidad}</b><small>{a.vdr} VD</small></li>)}
          </ul>
        </div>
      </div>

      <div class="mix mix--rev" data-reveal>
        <div class="mix__img"><Picture src={botanicos} {...imgProps} sizes="(min-width: 920px) 520px, 100vw" alt="TESTO-GH junto a fenogreco, ashwagandha y tribulus" loading="lazy" /></div>
        <div class="mix__body">
          <h3>Botánicos y aminoácido</h3>
          <ul class="rows rows--desc">
            {botanicosLista.map(({ a, t }) => <li><span>{a.nombre}{a.detalle && <em> · {a.detalle}</em>}</span><b>{a.cantidad}</b><p>{t}</p></li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ POR QUÉ -->
  <section class="section" aria-labelledby="t-por-que">
    <div class="container">
      <div class="head" data-reveal>
        <span class="eyebrow">Por qué pedirlo aquí</span>
        <h2 id="t-por-que">Simple de tomar. Fácil de pedir.</h2>
      </div>
      <div class="grid grid--4">
        <article class="card why" data-reveal>
          <span class="why__icon"><Icon name="capsule" /></span>
          <h3>Todo en un frasco</h3>
          <p>Vitaminas, minerales y botánicos juntos: no necesitas combinar varios productos.</p>
        </article>
        <article class="card why" data-reveal>
          <span class="why__icon"><Icon name="tag" /></span>
          <h3>Mejor precio x2</h3>
          <p>{dos.capsulas} cápsulas ({dias * 2} días) por {formatoUSD(dos.precioCentavos)}: cada frasco te sale a {formatoUSD(ahorro.precioPorFrascoCentavos)}.</p>
        </article>
        <article class="card why" data-reveal>
          <span class="why__icon"><Icon name="chat" /></span>
          <h3>Atención real</h3>
          <p>Te respondemos por WhatsApp antes y después de tu compra.</p>
        </article>
        <article class="card why" data-reveal>
          <span class="why__icon"><Icon name="cash" /></span>
          <h3>Sin riesgo al pedir</h3>
          <p>No pagas nada por adelantado: confirmas por WhatsApp y pagas al recibir.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============================================================ RUTINA -->
  <section class="section section--white" id="uso" aria-labelledby="t-uso">
    <div class="container split">
      <div class="mix__img" data-reveal>
        <Picture src={buenaRutina} {...imgProps} sizes="(min-width: 920px) 560px, 100vw" alt="Hombre desayunando junto a un frasco de TESTO-GH: alimentación, movimiento y descanso" loading="lazy" />
      </div>
      <div class="stack" data-reveal>
        <span class="eyebrow">Cómo se toma</span>
        <h2 id="t-uso" style="font-size:var(--fs-h2)">2 cápsulas al día, con una comida</h2>
        <p class="lead">Según la etiqueta: {PRODUCTO.modoDeUso}</p>
        <div class="duration">
          <div><strong>{dias} días</strong><span>con 1 frasco ({uno.capsulas} cápsulas)</span></div>
          <div><strong>{dias * 2} días</strong><span>con 2 frascos{porDia ? ` · ${formatoUSD(porDia)} al día` : ""}</span></div>
        </div>
        <p class="note"><Icon name="info" size={20} /> <span>Es un complemento: funciona como parte de tus hábitos de alimentación, movimiento y descanso, no los reemplaza.</span></p>
      </div>
    </div>
  </section>

  <!-- ============================================================ ETIQUETA -->
  <section class="section" id="etiqueta" aria-labelledby="t-etiqueta">
    <div class="container split">
      <div class="stack" data-reveal>
        <span class="eyebrow">Transparencia</span>
        <h2 id="t-etiqueta" style="font-size:var(--fs-h2)">Revisa la etiqueta antes de pedir</h2>
        <button type="button" class="label-btn" data-ampliar={zoomEtiqueta.src} data-alt="Etiqueta posterior de TESTO-GH" aria-label="Ampliar la etiqueta posterior de TESTO-GH">
          <Picture src={etiqueta} {...imgProps} widths={[480, 760]} sizes="(min-width: 920px) 520px, 100vw" alt="Etiqueta posterior de TESTO-GH: información nutricional, modo de uso y advertencias" loading="lazy" />
          <span class="zoom"><Icon name="zoom" size={14} /> Ampliar</span>
        </button>
      </div>
      <div class="stack" data-reveal>
        <details class="details" open>
          <summary>Advertencias de la etiqueta <Icon name="chevron" size={20} /></summary>
          <div class="details__body">
            <ul class="warnings">{PRODUCTO.advertencias.map((a) => <li><Icon name="alert" size={16} /> {a}</li>)}</ul>
          </div>
        </details>
        <p class="note note--warn"><Icon name="alert" size={20} /> <span><strong>Nota de REVIVE GROW:</strong> consulta a tu médico antes de tomarlo si tienes alguna condición de tiroides, hígado o presión arterial, o si tomas medicamentos. Producto para hombres adultos.</span></p>
        <p class="note"><Icon name="info" size={20} /> <span>Es un suplemento alimenticio: complementa tu alimentación, no la reemplaza, y no sustituye ningún tratamiento médico.</span></p>
        <p class="small">Distribuido por GENETICS®, según la etiqueta.</p>
      </div>
    </div>
  </section>

  <!-- ============================================================ CONTRA ENTREGA -->
  <section class="section section--navy" id="contra-entrega" aria-labelledby="t-cod">
    <div class="container">
      <div class="head" data-reveal>
        <span class="eyebrow">Pago contra entrega</span>
        <h2 id="t-cod">Pides hoy. Pagas cuando lo tienes en tus manos.</h2>
        <p class="lead">Sin tarjetas, sin transferencias por adelantado y sin sorpresas: antes de enviar te confirmamos el total.</p>
      </div>
      <ol class="steps">
        <li class="step" data-reveal><span class="step__n">1</span><h3>Elige tu paquete</h3><p>1 frasco o 2 frascos con ahorro de {formatoUSD(ahorro.ahorroCentavos)}.</p></li>
        <li class="step" data-reveal><span class="step__n">2</span><h3>Déjanos tus datos</h3><p>Nombre, celular y dirección de entrega. Menos de un minuto.</p></li>
        <li class="step" data-reveal><span class="step__n">3</span><h3>Te confirmamos</h3><p>Te escribimos por WhatsApp con el total {TIENDA.envio.costoCentavos === null ? "incluido el envío" : "final"} antes de despachar.</p></li>
        <li class="step" data-reveal><span class="step__n">4</span><h3>Recibes y pagas</h3><p>Verificas tu paquete y pagas al recibirlo{formas?.length ? ` (${formas.join(" o ")})` : ""}.</p></li>
      </ol>
      <ul class="cod-facts">
        <li><Icon name="lock" size={20} /> No pedimos datos de tarjeta ni bancarios.</li>
        <li><Icon name="truck" size={20} /> {TIENDA.envio.plazo ? `Entrega estimada: ${TIENDA.envio.plazo}.` : "Plazo de entrega confirmado por WhatsApp según tu ciudad."}</li>
        <li><Icon name="chat" size={20} /> ¿Dudas? Te respondemos por WhatsApp al {TIENDA.whatsapp.visible}.</li>
      </ul>
    </div>
  </section>

  <!-- ============================================================ OFERTA -->
  <section class="section" id="oferta" aria-labelledby="t-oferta">
    <div class="container">
      <div class="offer" data-oculta-barra>
        <div class="offer__media offer__media--studio">
          <Picture {...fotoProps} sizes="(min-width: 920px) 460px, 90vw" alt="TESTO-GH, frasco de 60 cápsulas" />
        </div>
        <div class="offer__box">
          <span class="eyebrow">Oferta especial — lleva 2</span>
          <h2 id="t-oferta">2 frascos por solo {formatoUSD(dos.precioCentavos)}</h2>
          <p class="lead">Ahorras {formatoUSD(ahorro.ahorroCentavos)} frente a comprar 2 frascos por separado ({formatoUSD(ahorro.porSeparadoCentavos)}). Recibes {dos.capsulas} cápsulas{textoDuracion(2) && ` (${textoDuracion(2)}${DURACION?.fuente === "proveedor" ? " según el proveedor" : ""})`} y cada frasco te sale a {formatoUSD(ahorro.precioPorFrascoCentavos)}.</p>
          <PackSelector grupo="oferta" titulo="Tu paquete" />
          <a class="btn btn--cta btn--lg btn--block" href={waPedido} data-abrir-pedido>
            <span class="btn-stack">PEDIR AHORA — PAGA AL RECIBIR<span class="sub"><span data-sel-nombre>{inicial.nombre}</span> · <span data-sel-precio>{formatoUSD(inicial.precioCentavos)}</span></span></span>
          </a>
          <p class="stock" data-stock role="status">
            <Icon name="clock" size={20} />
            <span data-stock-texto><span class="stock__count" data-stock-cifra></span>Unidades limitadas · Aprovecha el precio especial mientras haya disponibilidad.</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ FAQ -->
  <section class="section section--white" id="preguntas" aria-labelledby="t-faq">
    <div class="container narrow">
      <div class="head head--center" data-reveal>
        <span class="eyebrow">Preguntas frecuentes</span>
        <h2 id="t-faq">Resolvemos tus dudas</h2>
      </div>
      <div class="faq">
        {FAQ.map((f, i) => (
          <details class="details" open={i === 0}>
            <summary>{f.p} <Icon name="chevron" size={20} /></summary>
            <div class="details__body"><p set:html={f.r} /></div>
          </details>
        ))}
      </div>
      <div class="stack" style="margin-top:2rem;justify-items:center;text-align:center">
        <p class="muted">¿Tienes otra pregunta?</p>
        <a class="btn btn--ghost" href={enlaceWhatsApp(MENSAJE_CONSULTA)} target="_blank" rel="noopener" data-evento="Contact"><Icon name="whatsapp" /> Pregúntanos por WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- ============================================================ CIERRE -->
  <section class="section" aria-label="Información importante">
    <div class="container narrow disclaimer">
      <p><strong>Importante.</strong> TESTO-GH es un suplemento alimenticio para hombres adultos. No es un medicamento, no está destinado a diagnosticar, tratar, curar ni prevenir enfermedades y no reemplaza una alimentación variada y equilibrada. Los resultados pueden variar de una persona a otra.</p>
      <p>Si tomas medicamentos o tienes alguna condición de salud, consulta a tu médico antes de consumirlo. No apto para menores de edad ni para mujeres embarazadas o en período de lactancia.</p>
    </div>
  </section>

  <Fragment slot="despues">
    <OrderDialog />

    <dialog class="viewer" id="dlg-imagen" aria-label="Etiqueta ampliada">
      <div class="viewer__in">
        <img data-visor alt="" width="1024" height="1536" decoding="async" />
        <button type="button" class="icon-btn" data-cerrar-visor aria-label="Cerrar"><Icon name="close" /></button>
      </div>
    </dialog>

    <div class="sticky" data-sticky aria-hidden="true">
      <div class="sticky__info">
        <small><span data-sel-nombre>{inicial.nombre}</span> · pagas al recibir</small>
        <strong data-sel-precio>{formatoUSD(inicial.precioCentavos)}</strong>
      </div>
      <a class="btn btn--cta" href={waPedido} data-abrir-pedido tabindex="-1">PEDIR AHORA</a>
    </div>

    <a class="fab" href={enlaceWhatsApp(MENSAJE_CONSULTA)} target="_blank" rel="noopener" aria-label="Consultas por WhatsApp" data-evento="Contact">
      <Icon name="whatsapp" size={30} />
    </a>
  </Fragment>
</Base>

<script>
  import "../scripts/pedido";

  const visor = document.querySelector<HTMLDialogElement>("#dlg-imagen");
  const img = visor?.querySelector<HTMLImageElement>("[data-visor]");
  document.querySelectorAll<HTMLButtonElement>("[data-ampliar]").forEach((b) =>
    b.addEventListener("click", () => {
      if (!visor || !img) return;
      img.src = b.dataset.ampliar!;
      img.alt = b.dataset.alt ?? "";
      visor.showModal();
    }),
  );
  visor?.addEventListener("click", (e) => {
    const t = e.target as Element;
    if (t === visor || t.closest("[data-cerrar-visor]")) visor.close();
  });
</script>
