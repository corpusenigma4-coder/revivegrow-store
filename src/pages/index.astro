---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import PackSelector from "../components/PackSelector.astro";
import OrderDialog from "../components/OrderDialog.astro";
import frasco from "../assets/img/testo-gh-frasco.webp";
import { PAQUETES, PAQUETE_INICIAL, TIENDA, enlaceWhatsApp, MENSAJE_CONSULTA } from "../config/tienda";
import { PRODUCTO, DIAS_POR_FRASCO, DURACION, textoDuracion } from "../config/producto";
import { ahorroPaquete, formatoUSD, paquetePorId } from "../lib/pedido";
import { FAQ } from "../data/faq";
import { ruta } from "../lib/ruta";
import { CATALOGO } from "../config/catalogo";

const dos = paquetePorId("dos")!;
const uno = paquetePorId("uno")!;
const ahorro = ahorroPaquete(dos);
const inicial = paquetePorId(PAQUETE_INICIAL)!;
const waPedido = enlaceWhatsApp("Hola REVIVE GROW, quiero hacer un pedido de TESTO-GH con pago contra entrega.");
const waEtiqueta = enlaceWhatsApp("Hola REVIVE GROW, ¿me pueden enviar la foto de la etiqueta posterior de TESTO-GH (ingredientes y modo de uso)?");
const formas = TIENDA.pago.formasAlRecibir;
const tieneComposicion = PRODUCTO.activos.length > 0 || Boolean(PRODUCTO.ingredientes);

const titulo = "TESTO-GH Multi Vitamin For Men | Pago contra entrega en Ecuador · REVIVE GROW";
const descripcion = `TESTO-GH, multivitamínico para hombres de ${PRODUCTO.marca}. ${PRODUCTO.capsulasPorFrasco} cápsulas por frasco. 2 frascos por ${formatoUSD(dos.precioCentavos)} (ahorras ${formatoUSD(ahorro.ahorroCentavos)}). Pagas al recibir.`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: PRODUCTO.nombreCompleto,
    description: `${PRODUCTO.tipo}, ${PRODUCTO.capsulasPorFrasco} cápsulas.`,
    image: new URL(ruta("/og-revivegrow-ec.jpg"), Astro.site ?? TIENDA.url).href,
    brand: { "@type": "Brand", name: PRODUCTO.marca },
    offers: PAQUETES.map((p) => ({
      "@type": "Offer",
      name: p.nombre,
      price: (p.precioCentavos / 100).toFixed(2),
      priceCurrency: "USD",
      availability: "https://schema.org/LimitedAvailability",
      areaServed: "EC",
      seller: { "@type": "Organization", name: "REVIVE GROW" },
    })),
  },
];
const fotoProps = { src: frasco, formats: ["avif", "webp"] as const, fallbackFormat: "webp" as const, quality: 80, widths: [480, 760, 1024] };
---
<Base title={titulo} description={descripcion} jsonLd={jsonLd} producto={CATALOGO["testo-gh"]}>
  <!-- ============================================================ HERO + OFERTA -->
  <section class="hero" aria-labelledby="titulo-producto">
    <div class="container hero__grid">
      <figure class="hero__media hero__media--studio">
        <Picture {...fotoProps} sizes="(min-width: 920px) 560px, 100vw" alt="Frasco de TESTO-GH Multi Vitamin For Men, 60 cápsulas" loading="eager" fetchpriority="high" />
        <span class="hero__price">2 frascos · {formatoUSD(dos.precioCentavos)} <small>Ahorras {formatoUSD(ahorro.ahorroCentavos)}</small></span>
        <div class="hero__tags">
          <span class="tag"><Icon name="capsule" size={15} /> {PRODUCTO.capsulasPorFrasco} cápsulas</span>
          <span class="tag"><Icon name="user" size={15} /> Para hombres</span>
        </div>
      </figure>

      <div class="buy" id="comprar">
        <span class="eyebrow">{PRODUCTO.marca}</span>
        <h1 id="titulo-producto">TESTO-GH <span>Multivitamínico para hombres · {PRODUCTO.capsulasPorFrasco} cápsulas</span></h1>
        <p class="buy__lead">
          Un complemento en cápsulas pensado para hombres con una rutina activa. Pídelo hoy y <strong>pagas cuando lo recibes</strong>.
        </p>

        <PackSelector grupo="hero" />
        <p class="pack-note" data-aviso-paquete hidden></p>

        <a class="btn btn--cta btn--lg btn--block" href={waPedido} data-abrir-pedido data-oculta-barra>
          <span class="btn-stack">PEDIR AHORA — PAGA AL RECIBIR<span class="sub"><span data-sel-nombre>{inicial.nombre}</span> · <span data-sel-precio>{formatoUSD(inicial.precioCentavos)}</span></span></span>
        </a>

        <ul class="trust">
          <li><Icon name="cash" /> <div>Pagas al recibir <span>— sin tarjeta ni pagos por adelantado.</span></div></li>
          <li><Icon name="whatsapp" /> <div>Confirmación por WhatsApp <span>— te escribimos antes de enviar.</span></div></li>
          <li><Icon name="shield" /> <div>Frasco con sello de seguridad <span>— verifícalo al recibir.</span></div></li>
        </ul>

        <p class="stock" data-stock role="status">
          <Icon name="clock" size={20} />
          <span data-stock-texto><span class="stock__count" data-stock-cifra></span>Unidades limitadas · Oferta sujeta a disponibilidad.</span>
        </p>
        {DURACION && (
          <p class="small">
            {DURACION.fuente === "etiqueta"
              ? `* Duración calculada con la dosis de la etiqueta: ${DURACION.diasPorFrasco} días por frasco.`
              : "* Duración aproximada indicada por el proveedor (60 cápsulas para un mes). Sigue siempre el modo de uso impreso en el frasco."}
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- ============================================================ PRODUCTO -->
  <section class="section section--white" id="producto" aria-labelledby="t-producto">
    <div class="container">
      <div class="head" data-reveal>
        <span class="eyebrow">Qué es</span>
        <h2 id="t-producto">Tu multivitamínico, en un frasco práctico</h2>
        <p class="lead">TESTO-GH se presenta como <em>Multi Vitamin For Men</em>: un multivitamínico en cápsulas pensado para el hombre activo, que entrena, trabaja y quiere cuidar su alimentación con un solo producto.</p>
      </div>
      <div class="grid grid--3">
        <article class="card ingr" data-reveal>
          <div class="ingr__top">
            <span class="ingr__icon"><Icon name="user" size={28} /></span>
            <div class="ingr__qty"><strong>Hombres</strong><small>adultos</small></div>
          </div>
          <h3>Multi Vitamin For Men</h3>
          <p>Así lo identifica su envase: un multivitamínico pensado para el hombre adulto que cuida su alimentación y su rutina.</p>
        </article>
        <article class="card ingr" data-reveal>
          <div class="ingr__top">
            <span class="ingr__icon"><Icon name="capsule" size={28} /></span>
            <div class="ingr__qty"><strong>{PRODUCTO.capsulasPorFrasco}</strong><small>cápsulas por frasco</small></div>
          </div>
          <h3>Formato en cápsulas</h3>
          <p>Fácil de llevar y de tomar. {textoDuracion(1) ? `Cada frasco rinde ${textoDuracion(1)}${DURACION?.fuente === "proveedor" ? " según el proveedor" : ""}; con 2 frascos recibes ${dos.capsulas} cápsulas.` : `Con el paquete de 2 frascos recibes ${dos.capsulas} cápsulas.`}</p>
        </article>
        <article class="card ingr" data-reveal>
          <div class="ingr__top">
            <span class="ingr__icon"><Icon name="shield" size={28} /></span>
            <div class="ingr__qty"><strong>Sellado</strong><small>de fábrica</small></div>
          </div>
          <h3>{PRODUCTO.marca}</h3>
          <p>Frasco original con sello de seguridad en la tapa. Verifica que esté intacto al recibirlo.</p>
        </article>
      </div>

      {tieneComposicion ? (
        <div class="split" style="margin-top:1.5rem">
          {PRODUCTO.activos.length > 0 && (
            <table class="facts">
              <caption>Información nutricional{PRODUCTO.porcion && ` · porción ${PRODUCTO.porcion.capsulas} cápsulas`}</caption>
              <thead><tr><th scope="col">Nutriente</th><th scope="col">Por porción</th><th scope="col">%VDR</th></tr></thead>
              <tbody>{PRODUCTO.activos.map((a) => <tr><td>{a.nombre}</td><td>{a.cantidad}</td><td>{a.vdr ?? "*"}</td></tr>)}</tbody>
            </table>
          )}
          {PRODUCTO.ingredientes && (
            <details class="details" open>
              <summary>Ingredientes <Icon name="chevron" size={20} /></summary>
              <div class="details__body"><p>{PRODUCTO.ingredientes}</p></div>
            </details>
          )}
        </div>
      ) : (
        <div class="note" style="margin-top:1.25rem" data-reveal>
          <Icon name="info" size={20} />
          <span>
            <strong>Composición y modo de uso:</strong> los publicaremos tal como figuran en la etiqueta posterior del frasco.
            Si quieres verlos antes de pedir, te enviamos la foto de la etiqueta por WhatsApp.
            <a class="link" href={waEtiqueta} target="_blank" rel="noopener" data-evento="Contact">Pedir foto de la etiqueta</a>
          </span>
        </div>
      )}
    </div>
  </section>

  <!-- ============================================================ POR QUÉ -->
  <section class="section" aria-labelledby="t-por-que">
    <div class="container">
      <div class="head" data-reveal>
        <span class="eyebrow">Por qué pedirlo aquí</span>
        <h2 id="t-por-que">Simple de tomar. Fácil de pedir.</h2>
      </div>
      <div class="grid grid--4">
        <article class="card why" data-reveal>
          <span class="why__icon"><Icon name="capsule" /></span>
          <h3>Formato práctico</h3>
          <p>Cápsulas listas para integrar a tu día, en casa, en el trabajo o después de entrenar.</p>
        </article>
        <article class="card why" data-reveal>
          <span class="why__icon"><Icon name="tag" /></span>
          <h3>Mejor precio x2</h3>
          <p>{dos.capsulas} cápsulas por {formatoUSD(dos.precioCentavos)}: cada frasco te sale a {formatoUSD(ahorro.precioPorFrascoCentavos)}.</p>
        </article>
        <article class="card why" data-reveal>
          <span class="why__icon"><Icon name="chat" /></span>
          <h3>Atención real</h3>
          <p>Te respondemos por WhatsApp antes y después de tu compra.</p>
        </article>
        <article class="card why" data-reveal>
          <span class="why__icon"><Icon name="cash" /></span>
          <h3>Sin riesgo al pedir</h3>
          <p>No pagas nada por adelantado: confirmas por WhatsApp y pagas al recibir.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============================================================ USO Y PRECAUCIONES -->
  <section class="section section--white" id="uso" aria-labelledby="t-uso">
    <div class="container split">
      <div class="stack" data-reveal>
        <span class="eyebrow">Cómo se toma</span>
        <h2 id="t-uso" style="font-size:var(--fs-h2)">Sigue la etiqueta, sin excederte</h2>
        {PRODUCTO.modoDeUso ? (
          <p class="lead">Según la etiqueta: {PRODUCTO.modoDeUso} {PRODUCTO.publico}</p>
        ) : (
          <p class="lead">Toma TESTO-GH siguiendo el modo de uso impreso en la etiqueta del frasco y no superes la dosis recomendada.</p>
        )}
        {DIAS_POR_FRASCO && (
          <div class="duration">
            <div><strong>{DIAS_POR_FRASCO} días</strong><span>con 1 frasco ({uno.capsulas} cápsulas)</span></div>
            <div><strong>{DIAS_POR_FRASCO * 2} días</strong><span>con 2 frascos ({dos.capsulas} cápsulas)</span></div>
          </div>
        )}
        {PRODUCTO.almacenamiento && <p class="note"><Icon name="box" size={20} /> <span>{PRODUCTO.almacenamiento}</span></p>}
      </div>
      <div class="stack" data-reveal>
        <details class="details" open>
          <summary>{PRODUCTO.advertencias.length ? "Advertencias de la etiqueta" : "Antes de consumirlo"} <Icon name="chevron" size={20} /></summary>
          <div class="details__body">
            <ul class="warnings">
              {(PRODUCTO.advertencias.length
                ? PRODUCTO.advertencias
                : [
                    "Producto para hombres adultos. Manténgase fuera del alcance de los niños.",
                    "No apto para mujeres embarazadas o en período de lactancia.",
                    "Si tomas algún medicamento o tienes una condición de salud, consulta a tu médico antes de consumirlo.",
                    "No superes la dosis recomendada en la etiqueta.",
                    "No lo uses si el sello de seguridad está roto o no lo tiene.",
                  ]
              ).map((a) => <li><Icon name="alert" size={16} /> {a}</li>)}
            </ul>
          </div>
        </details>
        <p class="note"><Icon name="info" size={20} /> <span>Es un suplemento alimenticio: complementa tu alimentación, no la reemplaza, y no sustituye ningún tratamiento médico.</span></p>
      </div>
    </div>
  </section>

  <!-- ============================================================ CONTRA ENTREGA -->
  <section class="section section--navy" id="contra-entrega" aria-labelledby="t-cod">
    <div class="container">
      <div class="head" data-reveal>
        <span class="eyebrow">Pago contra entrega</span>
        <h2 id="t-cod">Pides hoy. Pagas cuando lo tienes en tus manos.</h2>
        <p class="lead">Sin tarjetas, sin transferencias por adelantado y sin sorpresas: antes de enviar te confirmamos el total.</p>
      </div>
      <ol class="steps">
        <li class="step" data-reveal><span class="step__n">1</span><h3>Elige tu paquete</h3><p>1 frasco o 2 frascos con ahorro de {formatoUSD(ahorro.ahorroCentavos)}.</p></li>
        <li class="step" data-reveal><span class="step__n">2</span><h3>Déjanos tus datos</h3><p>Nombre, celular y dirección de entrega. Menos de un minuto.</p></li>
        <li class="step" data-reveal><span class="step__n">3</span><h3>Te confirmamos</h3><p>Te escribimos por WhatsApp con el total {TIENDA.envio.costoCentavos === null ? "incluido el envío" : "final"} antes de despachar.</p></li>
        <li class="step" data-reveal><span class="step__n">4</span><h3>Recibes y pagas</h3><p>Verificas tu paquete y pagas al recibirlo{formas?.length ? ` (${formas.join(" o ")})` : ""}.</p></li>
      </ol>
      <ul class="cod-facts">
        <li><Icon name="lock" size={20} /> No pedimos datos de tarjeta ni bancarios.</li>
        <li><Icon name="truck" size={20} /> {TIENDA.envio.plazo ? `Entrega estimada: ${TIENDA.envio.plazo}.` : "Plazo de entrega confirmado por WhatsApp según tu ciudad."}</li>
        <li><Icon name="chat" size={20} /> ¿Dudas? Te respondemos por WhatsApp al {TIENDA.whatsapp.visible}.</li>
      </ul>
    </div>
  </section>

  <!-- ============================================================ OFERTA -->
  <section class="section" id="oferta" aria-labelledby="t-oferta">
    <div class="container">
      <div class="offer" data-oculta-barra>
        <div class="offer__media offer__media--studio">
          <Picture {...fotoProps} sizes="(min-width: 920px) 460px, 90vw" alt="TESTO-GH, frasco de 60 cápsulas" />
        </div>
        <div class="offer__box">
          <span class="eyebrow">Oferta especial — lleva 2</span>
          <h2 id="t-oferta">2 frascos por solo {formatoUSD(dos.precioCentavos)}</h2>
          <p class="lead">Ahorras {formatoUSD(ahorro.ahorroCentavos)} frente a comprar 2 frascos por separado ({formatoUSD(ahorro.porSeparadoCentavos)}). Recibes {dos.capsulas} cápsulas{textoDuracion(2) && ` (${textoDuracion(2)}${DURACION?.fuente === "proveedor" ? " según el proveedor" : ""})`} y cada frasco te sale a {formatoUSD(ahorro.precioPorFrascoCentavos)}.</p>
          <PackSelector grupo="oferta" titulo="Tu paquete" />
          <a class="btn btn--cta btn--lg btn--block" href={waPedido} data-abrir-pedido>
            <span class="btn-stack">PEDIR AHORA — PAGA AL RECIBIR<span class="sub"><span data-sel-nombre>{inicial.nombre}</span> · <span data-sel-precio>{formatoUSD(inicial.precioCentavos)}</span></span></span>
          </a>
          <p class="stock" data-stock role="status">
            <Icon name="clock" size={20} />
            <span data-stock-texto><span class="stock__count" data-stock-cifra></span>Unidades limitadas · Aprovecha el precio especial mientras haya disponibilidad.</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ FAQ -->
  <section class="section section--white" id="preguntas" aria-labelledby="t-faq">
    <div class="container narrow">
      <div class="head head--center" data-reveal>
        <span class="eyebrow">Preguntas frecuentes</span>
        <h2 id="t-faq">Resolvemos tus dudas</h2>
      </div>
      <div class="faq">
        {FAQ.map((f, i) => (
          <details class="details" open={i === 0}>
            <summary>{f.p} <Icon name="chevron" size={20} /></summary>
            <div class="details__body"><p set:html={f.r} /></div>
          </details>
        ))}
      </div>
      <div class="stack" style="margin-top:2rem;justify-items:center;text-align:center">
        <p class="muted">¿Tienes otra pregunta?</p>
        <a class="btn btn--ghost" href={enlaceWhatsApp(MENSAJE_CONSULTA)} target="_blank" rel="noopener" data-evento="Contact"><Icon name="whatsapp" /> Pregúntanos por WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- ============================================================ CIERRE -->
  <section class="section" aria-label="Información importante">
    <div class="container narrow disclaimer">
      <p><strong>Importante.</strong> TESTO-GH es un suplemento alimenticio para hombres adultos. No es un medicamento, no está destinado a diagnosticar, tratar, curar ni prevenir enfermedades y no reemplaza una alimentación variada y equilibrada. Los resultados pueden variar de una persona a otra.</p>
      <p>Si tomas medicamentos o tienes alguna condición de salud, consulta a tu médico antes de consumirlo. No apto para menores de edad ni para mujeres embarazadas o en período de lactancia.</p>
    </div>
  </section>

  <Fragment slot="despues">
    <OrderDialog />

    <div class="sticky" data-sticky aria-hidden="true">
      <div class="sticky__info">
        <small><span data-sel-nombre>{inicial.nombre}</span> · pagas al recibir</small>
        <strong data-sel-precio>{formatoUSD(inicial.precioCentavos)}</strong>
      </div>
      <a class="btn btn--cta" href={waPedido} data-abrir-pedido tabindex="-1">PEDIR AHORA</a>
    </div>

    <a class="fab" href={enlaceWhatsApp(MENSAJE_CONSULTA)} target="_blank" rel="noopener" aria-label="Consultas por WhatsApp" data-evento="Contact">
      <Icon name="whatsapp" size={30} />
    </a>
  </Fragment>
</Base>

<script>
  import "../scripts/pedido";
</script>
