---
import Base from "../layouts/Base.astro";
import { SITE } from "../config/site";
import MediaGallery from "../components/MediaGallery.astro";
import imgAmbiance from "../assets/images/oreiller-ambiance.webp";
import imgHauteurs from "../assets/images/info-hauteurs.webp";
import imgReglage from "../assets/images/info-reglage.webp";
import imgMateriaux from "../assets/images/info-materiaux.webp";
import BuyBox from "../components/BuyBox.astro";
import SectionHead from "../components/SectionHead.astro";
import HeightConfigurator from "../components/HeightConfigurator.astro";
import Faq from "../components/Faq.astro";
import Pending from "../components/Pending.astro";
import Services from "../components/Services.astro";
import Anatomy from "../components/Anatomy.astro";
import StickyBuy from "../components/StickyBuy.astro";
import SupplierProof from "../components/SupplierProof.astro";
import { PILLOW, MASK, STRIPS } from "../config/product";
import { FAQ } from "../data/faq";
import packImg from "../assets/images/pack-trio.webp";
import topImg from "../assets/images/oreiller-dessus.webp";
import maskImg from "../assets/images/masque-hero.webp";
import maskCavImg from "../assets/images/masque-cavites.webp";
import stripsImg from "../assets/images/bandelettes-boite.webp";
import stripsPoseImg from "../assets/images/bandelettes-pose.webp";

const images = [
  { src: imgAmbiance, alt: "L’oreiller cervical ergonomique REVIVE GROW sur un lit, housse ivoire" },
  { src: packImg, alt: "Le pack : oreiller cervical, masque de sommeil et bandelettes nasales offerts", fit: "contain" as const },
  { src: imgHauteurs, alt: "Hauteur ajustable : noyau de 8 cm et 2 inserts amovibles de 3 cm, soit 8, 11 ou 14 cm" },
  { src: imgReglage, alt: "Ajuster la hauteur en 3 étapes : ouvrir la housse, retirer ou ajouter un insert, refermer" },
  { src: imgMateriaux, alt: "Matériaux : housse jacquard respirante, amovible et lavable, mousse à mémoire de forme" },
  { src: topImg, alt: "L’oreiller vu de dessus : forme anatomique et zone centrale abaissée", fit: "contain" as const },
  { src: maskImg, alt: "Masque de sommeil premium graphite" },
  { src: maskCavImg, alt: "Cavités intérieures du masque de sommeil" },
  { src: stripsImg, alt: "Boîte de bandelettes nasales premium" },
  { src: stripsPoseImg, alt: "Bandelette nasale posée sur le nez" },
];
const groups = [
  { title: PILLOW.name, specs: PILLOW.specs },
  { title: `${MASK.name} · offert`, specs: MASK.specs },
  { title: `${STRIPS.name} · offertes`, specs: STRIPS.specs },
];
---
<Base title="Oreiller Cervical Ergonomique Ajustable" description="Oreiller cervical ergonomique réglable en hauteur, livré avec un masque de sommeil et des bandelettes nasales offerts. Livraison offerte sous 3 à 5 jours ouvrés en France métropolitaine.">
  <div class="container crumbs"><a href="/">Accueil</a> <span aria-hidden="true">/</span> <span aria-current="page">L’oreiller cervical</span></div>
  <section class="pdp container" data-hero aria-label="Le pack">
    <div class="pdp__gallery"><MediaGallery id="galerie-produit" images={images} variant="pdp" eager /></div>
    <div class="pdp__buy"><BuyBox headingLevel="h1" /></div>
  </section>

  <section class="section section--lin" id="forme" aria-labelledby="forme-title">
    <div class="container">
      <SectionHead eyebrow="La forme" id="forme-title" title="Pensé dans le détail." lead="Touchez un repère pour découvrir chaque zone." />
      <Anatomy />
    </div>
  </section>

  <section class="section section--nuit" id="reglage" aria-labelledby="reglage-title">
    <div class="container">
      <SectionHead eyebrow="Le réglage" id="reglage-title" tone="ivoire" title="Composez votre hauteur." lead="Trois hauteurs, une seule housse. Choisissez, puis suivez les cinq gestes." />
      <HeightConfigurator />
    </div>
  </section>

  <section class="section" aria-labelledby="specs-title">
    <div class="container">
      <SectionHead eyebrow="Caractéristiques" id="specs-title" title="Fiche technique." lead="Les caractéristiques de chacun des trois articles du pack." />
      <div class="specs">
        {groups.map((g) => (
          <div class="specs__group">
            <h3 class="t-h4">{g.title}</h3>
            <dl>
              {g.specs.filter((s) => SITE.preview || s.value !== "À compléter").map((s) => (
                <div class="specs__row"><dt>{s.label}</dt><dd>{s.value}{!s.verified && <Pending note={s.note} />}</dd></div>
              ))}
            </dl>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--lin" aria-labelledby="proof-title">
    <div class="container">
      <SectionHead eyebrow="Ce qu’on en dit" id="proof-title" title="Des chiffres, avec leur source." />
      <SupplierProof />
    </div>
  </section>

  <section class="section" aria-labelledby="svc-title">
    <div class="container">
      <SectionHead eyebrow="Achat serein" id="svc-title" title="Livraison, retours et garanties." />
      <Services />
    </div>
  </section>

  <section class="section section--lin" aria-labelledby="faq-title">
    <div class="container--narrow">
      <SectionHead eyebrow="Questions fréquentes" id="faq-title" title="Vos questions." />
      <Faq items={FAQ} />
      <p class="pdp__ask">Une autre question&nbsp;? <a href="/contact">Écrivez-nous</a>.</p>
    </div>
  </section>
  <StickyBuy slot="after" />
</Base>
<style>
  .crumbs { padding-block: var(--s-4); font-size: var(--fs-xs); color: var(--c-encre-douce); }
  .crumbs a { color: inherit; }
  .pdp { display: grid; gap: var(--s-6); padding-bottom: var(--s-8); }
  @media (min-width: 960px) {
    .pdp { grid-template-columns: 1.25fr 1fr; gap: var(--s-8); align-items: start; }
    .pdp__buy { position: sticky; top: calc(var(--header-h) + var(--s-5)); }
  }
  .pdp__ask { margin-top: var(--s-5); }
  .specs { display: grid; gap: var(--s-6); }
  @media (min-width: 960px) { .specs { grid-template-columns: repeat(3, 1fr); } }
  .specs__group { display: grid; gap: var(--s-3); align-content: start; }
  .specs__row { display: grid; grid-template-columns: minmax(8rem, 40%) 1fr; gap: var(--s-3); padding-block: var(--s-3); border-bottom: var(--hairline); font-size: var(--fs-sm); }
  .specs__row dt { color: var(--c-encre-douce); }
</style>
