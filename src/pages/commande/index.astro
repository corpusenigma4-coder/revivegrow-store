---
/**
 * Tunnel de commande REVIVE GROW — parcours exact demandé par la marque :
 * « Obtenir l’offre » → 1. Commande (récapitulatif) → Suivant → 2. Livraison (e-mail + adresse) → Suivant
 * → 3. Paiement sécurisé (boutons officiels PayPal : PayPal / carte bancaire si PayPal la propose).
 * Les données saisies sont transmises à PayPal avec la commande (src/lib/order.ts) ; aucune donnée
 * bancaire ne transite par le site ; la confirmation n'apparaît qu'après capture COMPLETED par PayPal.
 */
import { Picture } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { CAMPAIGN } from "../../config/campaign";
import { PILLOW, MASK, STRIPS, SERVICE } from "../../config/product";
import { CONTACT, COMMERCE } from "../../config/commerce";
import { formatPrice } from "../../lib/format";
import packImg from "../../assets/images/pack-trio.webp";

const price = formatPrice(CAMPAIGN.price);
// Tunnel complet (3 étapes) seulement avec un ID client d'application REST PayPal ; sinon bouton hébergé (2 étapes).
const full = COMMERCE.checkoutEnabled && COMMERCE.provider === "paypal-buttons" && Boolean(COMMERCE.paypalButtons.clientId);
const mode = full ? "full" : "hosted";
const regions = new Intl.DisplayNames(["fr"], { type: "region", fallback: "none" });
const EXCLUDE = new Set(["EU", "EZ", "UN", "QO", "XA", "XB", "ZZ", "AC", "CP", "CQ", "DG", "EA", "IC", "TA", "AQ", "BV", "HM"]);
const A = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
const countries: { code: string; name: string }[] = [];
for (const a of A) for (const b of A) {
  const code = a + b; if (EXCLUDE.has(code)) continue;
  const name = regions.of(code); if (name && name !== code) countries.push({ code, name });
}
countries.sort((x, y) => x.name.localeCompare(y.name, "fr"));
---
<Base title="Votre commande" description="Commande du Pack Sommeil REVIVE GROW : oreiller cervical et deux cadeaux offerts, 32,40 €, livraison gratuite." checkout noindex>
  <section class="co" data-co data-mode={mode}>
    <div class="co__wrap">
      <h1 class="sr-only">Votre commande REVIVE GROW</h1>

      <ol class="co__steps" role="list" aria-label="Étapes de la commande">
        <li data-ind="commande"><span class="co__n">1</span>Commande</li>
        {full && <li data-ind="livraison"><span class="co__n">2</span>Livraison</li>}
        <li data-ind="paiement"><span class="co__n">{full ? 3 : 2}</span>Paiement</li>
      </ol>

      <noscript><p class="co__alert">Le paiement sécurisé nécessite JavaScript. Activez-le ou écrivez-nous à {CONTACT.email}.</p></noscript>

      <!-- ÉTAPE 1 — RÉCAPITULATIF -->
      <div class="co__panel" data-step="commande">
        <h2 class="co__title" tabindex="-1">Votre commande</h2>
        <article class="sum">
          <div class="sum__media">
            <Picture src={packImg} formats={["avif", "webp"]} fallbackFormat="webp" widths={[480, 760, 1100]} sizes="(min-width: 640px) 560px, 100vw" alt="Le Pack Sommeil : oreiller cervical, masque de sommeil et bandelettes nasales" loading="eager" fetchpriority="high" class="sum__img" />
            <span class="sum__badge"><Icon name="gift" size={15} /> 2 cadeaux offerts</span>
          </div>
          <h3 class="sum__name">Pack Sommeil REVIVE GROW</h3>
          <ul class="sum__items" role="list">
            <li><span class="sum__q">1</span><span>{PILLOW.name.charAt(0).toUpperCase() + PILLOW.name.slice(1)}</span></li>
            <li><span class="sum__q">1</span><span>{MASK.name.charAt(0).toUpperCase() + MASK.name.slice(1)}</span><span class="sum__gift">Offert</span></li>
            <li><span class="sum__q">+</span><span>{STRIPS.name.charAt(0).toUpperCase() + STRIPS.name.slice(1)}</span><span class="sum__gift">Offertes</span></li>
          </ul>
          <dl class="sum__totals">
            <div><dt>Quantité</dt><dd>1 pack</dd></div>
            <div><dt>Prix</dt><dd class="t-tabular">{price}</dd></div>
            <div><dt>Livraison <span class="sum__muted">{SERVICE.delivery.delay}</span></dt><dd class="sum__free">Gratuite</dd></div>
            <div class="sum__total"><dt>Total TTC</dt><dd class="t-tabular">{price}</dd></div>
          </dl>
        </article>
        <button type="button" class="co__btn" data-go={full ? "livraison" : "paiement"}>Suivant</button>
      </div>

      <!-- ÉTAPE 2 — COORDONNÉES ET ADRESSE -->
      {full && <form class="co__panel" data-step="livraison" hidden novalidate data-form>
        <h2 class="co__title" tabindex="-1">Livraison</h2>
        <p class="co__lead">Votre adresse e-mail et l’adresse où recevoir le pack.</p>
        <div class="f">
          <label for="co-email">Adresse e-mail</label>
          <input id="co-email" name="email" type="email" inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" required maxlength="254" />
          <p class="f__err" data-err="email" hidden>Indiquez une adresse e-mail valide (ex. prenom@exemple.fr).</p>
        </div>
        <div class="f">
          <label for="co-name">Nom et prénom</label>
          <input id="co-name" name="fullName" type="text" autocomplete="name" autocapitalize="words" required maxlength="300" />
          <p class="f__err" data-err="fullName" hidden>Indiquez le nom du destinataire.</p>
        </div>
        <div class="f">
          <label for="co-address1">Adresse</label>
          <input id="co-address1" name="address1" type="text" autocomplete="address-line1" required maxlength="300" />
          <p class="f__err" data-err="address1" hidden>Indiquez l’adresse de livraison.</p>
        </div>
        <div class="f">
          <label for="co-address2">Complément d’adresse <span class="f__opt">(facultatif)</span></label>
          <input id="co-address2" name="address2" type="text" autocomplete="address-line2" maxlength="300" />
        </div>
        <div class="f__row">
          <div class="f f--cp">
            <label for="co-postal">Code postal</label>
            <input id="co-postal" name="postalCode" type="text" autocomplete="postal-code" autocapitalize="characters" required maxlength="60" />
            <p class="f__err" data-err="postalCode" hidden>Indiquez le code postal.</p>
          </div>
          <div class="f">
            <label for="co-city">Ville</label>
            <input id="co-city" name="city" type="text" autocomplete="address-level2" required maxlength="120" />
            <p class="f__err" data-err="city" hidden>Indiquez la ville.</p>
          </div>
        </div>
        <div class="f">
          <label for="co-country">Pays</label>
          <select id="co-country" name="country" autocomplete="country" required>
            {countries.map((c) => <option value={c.code} selected={c.code === "FR"}>{c.name}</option>)}
          </select>
          <p class="f__err" data-err="country" hidden>Choisissez le pays de livraison.</p>
        </div>
        <div class="co__actions">
          <button type="button" class="co__btn co__btn--ghost" data-go="commande">Retour</button>
          <button type="submit" class="co__btn">Suivant</button>
        </div>
      </form>}

      <!-- ÉTAPE 3 — PAIEMENT -->
      <div class="co__panel" data-step="paiement" hidden>
        <h2 class="co__title" tabindex="-1">Paiement sécurisé</h2>
        <div class="recap">
          {full ? <div class="recap__row">
            <div>
              <p class="recap__label">Livraison à</p>
              <p class="recap__val" data-recap-address></p>
              <p class="recap__val recap__mail" data-recap-email></p>
            </div>
            <button type="button" class="recap__edit" data-go="livraison">Modifier</button>
          </div> : <p class="recap__val">Vous indiquerez votre adresse e-mail et votre adresse de livraison sur la page sécurisée de PayPal.</p>}
          <p class="recap__total"><span>Total à payer&nbsp;:</span> <strong class="t-tabular">{price}</strong></p>
          <p class="recap__sub">Pack Sommeil REVIVE GROW · 2 cadeaux offerts · livraison gratuite</p>
        </div>

        <p class="pay__legal">En choisissant un moyen de paiement, vous passez une commande avec obligation de paiement et acceptez nos <a href="/cgv/">conditions générales de vente</a>.</p>

        <div class="pay" data-pay>
          {!full && <section class="pay__opt" data-opt="hosted">
            <header class="pay__head"><span class="pay__name">PayPal ou carte bancaire</span><span class="pay__desc">Paiement par compte PayPal ou par carte (débit ou crédit) lorsque PayPal la propose</span></header>
            <div class="pay__slot" id="pp-hosted"><span class="pay__skel" aria-hidden="true"></span></div>
          </section>}
          {full && <>
          <section class="pay__opt" data-opt="paypal">
            <header class="pay__head"><span class="pay__name">PayPal</span><span class="pay__desc">Payez avec votre compte PayPal</span></header>
            <div class="pay__slot" id="pp-paypal"><span class="pay__skel" aria-hidden="true"></span></div>
          </section>
          <section class="pay__opt" data-opt="card">
            <header class="pay__head"><span class="pay__name"><Icon name="card" size={18} /> Carte bancaire — débit ou crédit</span><span class="pay__desc">Sans compte PayPal, sur le formulaire sécurisé de PayPal</span></header>
            <div class="pay__slot" id="pp-card"><span class="pay__skel" aria-hidden="true"></span></div>
            <p class="pay__unavail" data-card-unavailable hidden>Le paiement direct par carte n’est pas proposé par PayPal pour le moment. Vous pouvez utiliser le bouton PayPal ci-dessus, qui peut aussi accepter les cartes.</p>
          </section>
          </>}
          <p class="pay__status" data-pay-status role="status" aria-live="polite"></p>
          <p class="pay__error" data-pay-error role="alert" hidden></p>
        </div>

        <p class="pay__trust"><Icon name="lock" size={16} /> Paiement traité par PayPal. Nous ne recevons jamais vos données bancaires.</p>
        <button type="button" class="co__btn co__btn--ghost co__back3" data-go={full ? "livraison" : "commande"}>Retour</button>
      </div>

      <!-- CONFIRMATION (uniquement après paiement capturé par PayPal) -->
      <div class="co__panel" data-step="confirmation" hidden>
        <div class="done">
          <span class="done__ic"><Icon name="check" size={28} /></span>
          <h2 class="co__title" tabindex="-1" data-done-title>Merci, votre commande est confirmée</h2>
          <p class="done__txt" data-done-text></p>
          <dl class="done__ref">
            <div><dt>Référence</dt><dd data-done-ref></dd></div>
            <div><dt>Transaction PayPal</dt><dd data-done-tx></dd></div>
          </dl>
          <p class="done__txt">Livraison gratuite {SERVICE.delivery.delay}. Une question&nbsp;? <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></p>
          <a class="co__btn co__btn--ghost" href="/">Retour à la boutique</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { COMMERCE, CONTACT } from "../../config/commerce";
  import { CAMPAIGN } from "../../config/campaign";
  import { buildPayPalOrder, missingFields, captureConfirmed, orderReference, type Customer } from "../../lib/order";

  const CFG = {
    price: CAMPAIGN.price, currency: "EUR", shipping: 0, quantity: 1 as const,
    itemName: "Pack Sommeil REVIVE GROW",
    itemDescription: "Oreiller cervical ergonomique ajustable + masque de sommeil offert + bandelettes nasales offertes",
    brandName: "REVIVE GROW",
  };
  const KEY = "rg.commande.v1";
  const root = document.querySelector<HTMLElement>("[data-co]")!;
  const FULL = root.dataset.mode === "full";
  const STEPS = (FULL ? ["commande", "livraison", "paiement"] : ["commande", "paiement"]) as readonly string[];
  type Step = "commande" | "livraison" | "paiement" | "confirmation";
  const form = (root.querySelector<HTMLFormElement>("[data-form]") ?? document.createElement("form")) as HTMLFormElement;
  const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-step]"));
  const inds = Array.from(root.querySelectorAll<HTMLElement>("[data-ind]"));
  const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
  let finished = false;

  // ---- Données client (conservées pendant la session, jamais envoyées ailleurs qu'à PayPal) ----
  const FIELDS = ["email", "fullName", "address1", "address2", "postalCode", "city", "country"] as const;
  function read(): Customer {
    const d = new FormData(form);
    const o: any = {}; FIELDS.forEach((k) => (o[k] = String(d.get(k) ?? "").trim()));
    return o as Customer;
  }
  function save() { try { sessionStorage.setItem(KEY, JSON.stringify(read())); } catch {} }
  function restore() {
    try {
      const o = JSON.parse(sessionStorage.getItem(KEY) || "null");
      if (o) FIELDS.forEach((k) => { const el = form.elements.namedItem(k) as HTMLInputElement | null; if (el && o[k]) el.value = o[k]; });
    } catch {}
  }
  form.addEventListener("input", (e) => {
    save();
    const t = e.target as HTMLInputElement;
    if (t.getAttribute("aria-invalid") === "true" && !missingFields(read()).includes(t.name as keyof Customer)) markField(t.name, false);
  });

  function markField(name: string, bad: boolean) {
    const el = form.elements.namedItem(name) as HTMLElement | null;
    const err = form.querySelector<HTMLElement>(`[data-err="${name}"]`);
    if (el) { el.setAttribute("aria-invalid", String(bad)); if (err) { err.id = `err-${name}`; bad ? el.setAttribute("aria-describedby", err.id) : el.removeAttribute("aria-describedby"); } }
    if (err) err.hidden = !bad;
  }

  // ---- Navigation entre étapes (le bouton retour du téléphone fonctionne aussi) ----
  function show(step: Step) {
    panels.forEach((p) => (p.hidden = p.dataset.step !== step));
    const idx = STEPS.indexOf(step as any);
    inds.forEach((li, i) => {
      li.classList.toggle("is-done", step === "confirmation" || i < idx);
      li.classList.toggle("is-current", i === idx);
      if (i === idx) li.setAttribute("aria-current", "step"); else li.removeAttribute("aria-current");
    });
    root.dataset.current = step;
    window.scrollTo({ top: 0 });
    root.querySelector<HTMLElement>(`[data-step="${step}"] .co__title`)?.focus({ preventScroll: true });
    if (step === "livraison") loadSdk().catch(() => {}); // préchargement discret
    if (step === "paiement") { if (FULL) fillRecap(); mountPayPal(); }
    if (step === "commande" && !FULL) loadSdk().catch(() => {});
  }
  function route() {
    if (finished) return show("confirmation");
    let s = (location.hash.slice(1) || "commande") as Step;
    if (!STEPS.includes(s as any)) s = "commande";
    if (FULL && s === "paiement" && missingFields(read()).length) { s = "livraison"; history.replaceState(null, "", "#livraison"); }
    show(s);
  }
  const go = (s: Step) => { if (location.hash.slice(1) === s) route(); else location.hash = s; };
  root.querySelectorAll<HTMLElement>("[data-go]").forEach((b) => b.addEventListener("click", () => go(b.dataset.go as Step)));
  window.addEventListener("hashchange", route);

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const missing = missingFields(read());
    FIELDS.forEach((k) => markField(k, missing.includes(k as keyof Customer)));
    if (missing.length) { (form.elements.namedItem(missing[0]) as HTMLElement)?.focus(); return; }
    save(); go("paiement");
  });

  function fillRecap() {
    const c = read();
    const countryName = (form.elements.namedItem("country") as HTMLSelectElement).selectedOptions[0]?.textContent ?? c.country;
    $("[data-recap-address]").textContent = [c.fullName, c.address1, c.address2, `${c.postalCode} ${c.city}`, countryName].filter(Boolean).join(", ");
    $("[data-recap-email]").textContent = c.email;
  }

  // ---- Paiement : boutons officiels PayPal (même client-id public que la PR #15) ----
  let sdk: Promise<any> | null = null;
  function loadSdk(): Promise<any> {
    // Tunnel complet : ID d'application REST. Sinon : bouton hébergé de la PR #15 (même URL de SDK).
    const id = FULL ? COMMERCE.paypalButtons.clientId : COMMERCE.paypalHosted.clientId;
    const params = FULL ? COMMERCE.paypalButtons.sdkParams : "components=hosted-buttons&disable-funding=venmo&currency=EUR&locale=fr_FR";
    if (!COMMERCE.checkoutEnabled || !id) return Promise.reject(new Error("off"));
    if (sdk) return sdk;
    sdk = new Promise((resolve, reject) => {
      const s = document.createElement("script");
      s.src = `https://www.paypal.com/sdk/js?client-id=${encodeURIComponent(id)}&${params}`;
      s.async = true;
      s.onload = () => { const pp = (window as any).paypal; (FULL ? pp?.Buttons : pp?.HostedButtons) ? resolve(pp) : reject(new Error("sdk")); };
      s.onerror = () => { sdk = null; reject(new Error("network")); };
      document.head.appendChild(s);
    });
    return sdk;
  }

  const status = $("[data-pay-status]");
  const errorBox = $("[data-pay-error]");
  const setStatus = (t: string) => { status.textContent = t; };
  const setError = (html: string | null) => { errorBox.hidden = !html; errorBox.innerHTML = html ?? ""; };
  const contact = `<a href="mailto:${CONTACT.email}">${CONTACT.email}</a>`;
  /** Extrait un code lisible de l'erreur PayPal (ex. UNPROCESSABLE_ENTITY / POSTAL_CODE_REQUIRED). */
  function paypalErrorCode(err: unknown): string {
    const msg = String((err as any)?.message ?? err ?? "");
    const issue = msg.match(/"issue"\s*:\s*"([A-Z_]+)"/)?.[1];
    const name = msg.match(/"name"\s*:\s*"([A-Z_]+)"/)?.[1] ?? msg.match(/\b([A-Z][A-Z_]{5,})\b/)?.[1];
    return [name, issue].filter(Boolean).join(" / ") || msg.slice(0, 80).replace(/[<>]/g, "") || "inconnu";
  }
  let mounted = false;
  let reference = "";

  async function mountPayPal() {
    if (mounted) return;
    mounted = true;
    setError(null); setStatus("Chargement du paiement sécurisé…");
    const timer = window.setTimeout(() => { if (root.dataset.pay !== "ready") failLoad(); }, 20000);
    try {
      const pp = await loadSdk();
      if (!FULL) {
        await pp.HostedButtons({ hostedButtonId: COMMERCE.paypalHosted.hostedButtonId }).render("#pp-hosted");
        window.clearTimeout(timer);
        root.dataset.pay = "ready";
        root.querySelectorAll(".pay__skel").forEach((s) => s.remove());
        setStatus("");
        return;
      }
      const handlers = {
        createOrder: (_d: unknown, actions: any) => {
          setError(null);
          reference = orderReference();
          return actions.order.create(buildPayPalOrder(read(), CFG, reference));
        },
        onApprove: async (_d: unknown, actions: any) => {
          setStatus("Finalisation du paiement…");
          try {
            const details = await actions.order.capture();
            const r = captureConfirmed(details, CFG);
            const cap = details?.purchase_units?.[0]?.payments?.captures?.[0];
            if (r === "ok") return finish(details, cap?.id);
            setStatus("");
            if (r === "pending") setError(`Votre paiement est en cours de vérification par PayPal. Vous recevrez un e-mail de PayPal dès sa validation. Référence : <strong>${reference}</strong>.`);
            else setError(`Le montant reçu ne correspond pas au prix du pack. Votre commande ${reference} va être vérifiée et nous vous recontacterons. ${contact}`);
          } catch (err) {
            if (String((err as any)?.message ?? err).includes("INSTRUMENT_DECLINED")) { setStatus(""); setError("Ce moyen de paiement a été refusé. Choisissez-en un autre dans la fenêtre PayPal."); return actions.restart(); }
            setStatus(""); setError(`Le paiement n’a pas pu être finalisé. Vous pouvez réessayer. En cas de doute, écrivez-nous à ${contact} avec la référence ${reference}.`);
          }
        },
        onCancel: () => { setStatus(""); setError("Paiement annulé : aucun montant n’a été prélevé. Vous pouvez reprendre quand vous le souhaitez."); },
        onError: (err: unknown) => {
          const code = paypalErrorCode(err);
          console.error("[REVIVE GROW] Erreur PayPal", code, err);
          setStatus("");
          setError(`Le paiement n’a pas pu aboutir. Vérifiez vos informations puis réessayez, ou écrivez-nous à ${contact}.<br><small class="pay__code">Code PayPal : ${code}</small>`);
        },
      };
      const jobs: Promise<unknown>[] = [];
      const paypalBtn = pp.Buttons({ ...handlers, fundingSource: pp.FUNDING.PAYPAL, style: { layout: "vertical", color: "gold", shape: "pill", label: "paypal", height: 50 } });
      const cardBtn = pp.Buttons({ ...handlers, fundingSource: pp.FUNDING.CARD, style: { layout: "vertical", color: "black", shape: "pill", height: 50 } });
      if (paypalBtn.isEligible()) jobs.push(paypalBtn.render("#pp-paypal")); else root.querySelector<HTMLElement>('[data-opt="paypal"]')!.hidden = true;
      if (cardBtn.isEligible()) jobs.push(cardBtn.render("#pp-card"));
      else { $("#pp-card").hidden = true; $("[data-card-unavailable]").hidden = false; }
      await Promise.all(jobs);
      window.clearTimeout(timer);
      root.dataset.pay = "ready";
      root.querySelectorAll(".pay__skel").forEach((s) => s.remove());
      setStatus("");
    } catch {
      window.clearTimeout(timer);
      failLoad();
    }
  }
  function failLoad() {
    root.dataset.pay = "error";
    mounted = false;
    root.querySelectorAll(".pay__skel").forEach((s) => s.remove());
    setStatus("");
    setError(`Le paiement sécurisé n’a pas pu se charger. Vérifiez votre connexion puis <button type="button" class="pay__retry" data-retry>réessayez</button>, ou écrivez-nous à ${contact}.`);
    errorBox.querySelector("[data-retry]")?.addEventListener("click", () => location.reload());
  }

  function finish(details: any, captureId?: string) {
    finished = true;
    try { sessionStorage.removeItem(KEY); } catch {}
    const c = read();
    $("[data-done-ref]").textContent = reference;
    $("[data-done-tx]").textContent = captureId ?? details?.id ?? "—";
    $("[data-done-text]").textContent = `Votre paiement de 32,40 € a été accepté par PayPal. Un reçu PayPal vous est envoyé et nous vous écrirons à ${c.email} lors de l’expédition.`;
    history.replaceState(null, "", "#confirmation");
    show("confirmation");
  }

  restore();
  route();
</script>

<style>
  .co { padding-block: var(--s-5) var(--s-8); }
  .co__wrap { width: min(100% - 2 * var(--gutter), 600px); margin-inline: auto; display: grid; gap: var(--s-5); }

  .co__steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-2); font-size: 0.8125rem; font-weight: 600; color: var(--c-encre-douce); }
  .co__steps li { display: flex; align-items: center; gap: 8px; padding-top: 10px; border-top: 2px solid var(--c-sable-pale); }
  .co__steps li.is-current { color: var(--c-encre); border-top-color: var(--c-encre); }
  .co__steps li.is-done { color: var(--c-sauge); border-top-color: var(--c-sauge); }
  .co__n { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; border: 1px solid currentColor; font-size: 0.75rem; flex: none; }
