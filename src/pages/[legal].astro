---
import Base from "../layouts/Base.astro";
import { LEGAL } from "../data/legal";

export function getStaticPaths() {
  return LEGAL.map((pagina) => ({ params: { legal: pagina.slug }, props: { pagina } }));
}
const { pagina } = Astro.props;

/** Escapa HTML y convierte {{P:…}} en una marca visible de dato pendiente. */
const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const html = (t: string) => esc(t).replace(/\{\{P:(.+?)\}\}/g, '<mark class="pendiente">Pendiente: $1</mark>');
---
<Base title={`${pagina.titulo} · REVIVE GROW Ecuador`} description={pagina.descripcion} secundaria>
  <article class="container narrow legal">
    <h1>{pagina.titulo}</h1>
    <p class="small">Tienda REVIVE GROW · revivegrow.ec · Ecuador</p>
    {pagina.secciones.map((s) => (
      <section>
        <h2>{s.titulo}</h2>
        {s.parrafos.map((p) => <p set:html={html(p)} />)}
        {s.lista && <ul>{s.lista.map((li) => <li set:html={html(li)} />)}</ul>}
      </section>
    ))}
  </article>
</Base>
