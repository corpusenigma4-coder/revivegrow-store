---
import "@fontsource-variable/archivo/wdth.css";
import fuenteLatin from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import "../styles/global.css";
import { Image } from "astro:assets";
import logo from "../assets/img/logo.webp";
import Icon from "../components/Icon.astro";
import Footer from "../components/Footer.astro";
import { TIENDA, enlaceWhatsApp, MENSAJE_CONSULTA } from "../config/tienda";
import { ruta } from "../lib/ruta";

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  /** Páginas secundarias: cabecera con enlace de vuelta a la oferta. */
  secundaria?: boolean;
}
const { title, description, jsonLd = [], secundaria = false } = Astro.props;
const vistaPrevia = TIENDA.estado !== "operativa";
const origen = Astro.site ?? new URL(TIENDA.url);
const canonical = new URL(Astro.url.pathname, origen).href;
const ogImage = new URL(ruta("/og-revivegrow-ec.jpg"), origen).href;
const robots = vistaPrevia ? "noindex, nofollow" : "index, follow";
const pixel = TIENDA.metaPixelId;
---
<!doctype html>
<html lang="es-EC">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f6f1e9" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href={ruta("/favicon.svg")} type="image/svg+xml" />
    <link rel="preload" href={fuenteLatin} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:site_name" content="REVIVE GROW" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Frasco de TESTO-GH Multi Vitamin For Men, 60 cápsulas" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
    {pixel && (
      /* Píxel de Meta: solo se inserta si TIENDA.metaPixelId tiene un valor. Sin coincidencias avanzadas (no se envían datos personales). */
      <script is:inline define:vars={{ pixel }}>
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', pixel); fbq('track', 'PageView');
      </script>
    )}
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    {vistaPrevia && (
      <div class="preview-bar" role="note">
        <strong>Vista previa.</strong> La tienda aún no está habilitada para ventas: los pedidos enviados se marcan como PRUEBA.
      </div>
    )}
    <header class="header">
      <div class="container header__in">
        <a class="header__logo" href={ruta("/")} aria-label="REVIVE GROW, inicio">
          <Image src={logo} alt="REVIVE GROW" height={40} widths={[167, 334]} sizes="167px" loading="eager" />
        </a>
        <div class="header__right">
          {secundaria ? (
            <a class="header__wa" href={ruta("/#oferta")}><Icon name="tag" size={18} /> Ver la oferta</a>
          ) : (
            <span class="header__cod"><Icon name="cash" size={20} /> Pagas al recibir</span>
          )}
          <a class="header__wa" href={enlaceWhatsApp(MENSAJE_CONSULTA)} target="_blank" rel="noopener" data-evento="Contact" aria-label="Escríbenos por WhatsApp">
            <Icon name="whatsapp" size={20} /> <span>WhatsApp</span>
          </a>
        </div>
      </div>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <slot name="despues" />
    <script>
      const els = document.querySelectorAll("[data-reveal]");
      if ("IntersectionObserver" in window && els.length) {
        document.documentElement.classList.add("reveal");
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("is-visible"); io.unobserve(e.target); } }),
          { rootMargin: "0px 0px -6% 0px" },
        );
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add("is-visible"));
      document.addEventListener("click", (ev) => {
        const a = (ev.target as Element).closest<HTMLElement>("[data-evento]");
        const w = window as unknown as { fbq?: (...a: unknown[]) => void };
        if (a && w.fbq) w.fbq("track", a.dataset.evento);
      });
    </script>
  </body>
</html>
