{
  "name": "revivegrow-store",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "REVIVE GROW Ecuador — landing de Maca Negra + L-Arginina con pago contra entrega",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node --disable-warning=ExperimentalWarning scripts/launch-check.mjs --guardia",
    "build": "astro build",
    "preview": "astro preview --port 4321 --host 127.0.0.1",
    "test:unit": "node --disable-warning=ExperimentalWarning --test \"tests/unit/*.test.ts\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "test": "npm run test:unit && npm run build && npm run test:e2e",
    "check:launch": "node --disable-warning=ExperimentalWarning scripts/launch-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
