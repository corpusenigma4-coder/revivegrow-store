{
  "name": "revivegrow-store",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "REVIVE GROW — boutique en ligne (France métropolitaine)",
  "engines": { "node": ">=22.23.4" },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
